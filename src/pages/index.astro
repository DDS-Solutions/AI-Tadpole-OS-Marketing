---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/features/Hero.astro";
import ArchitectureLayers from "../components/features/ArchitectureLayers.astro";
import ScreenshotGallery from "../components/features/ScreenshotGallery.astro";
import TemplateCatalog from "../components/features/TemplateCatalog.astro";
import Roadmap from "../components/features/Roadmap.astro";
import FaqSection from "../components/features/FaqSection.astro";
import BottomCta from "../components/features/BottomCta.astro";
import LightboxModal from "../components/ui/LightboxModal.astro";

const homeFaqSchema = [
  {
    question: "What is AI-Tadpole-OS?",
    answer:
      "AI-Tadpole-OS is a local-first, sovereign multi-agent swarm runtime written in Rust (Axum/Tokio) and React 19 (Tauri) released under Plane 1 GA. It deterministically separates human directives, autonomous orchestration, and compiled execution across 62+ registered agents.",
  },
  {
    question: "Does AI-Tadpole-OS require cloud connectivity to operate?",
    answer:
      "No. The core runtime is local-first by default. It executes directly on your hardware with embedded LanceDB vector storage (768-dim IVF-PQ), local SQLite indexing, and support for local LLM endpoints (Ollama) or configurable Bring-Your-Own-Key cloud providers.",
  },
  {
    question:
      "How does the three-layer architecture guarantee deterministic reliability?",
    answer:
      "By isolating Layer 1 (Directive SOPs in Markdown/YAML specifying strict contracts), Layer 2 (Orchestration decision-making, topological DAG scheduling, and Agent 99 self-annealing), and Layer 3 (Deterministic Rust and Python execution tools), AI-Tadpole-OS stops probabilistic error compounding.",
  },
  {
    question: "What is the Active Documentation Guard (ADG v2)?",
    answer:
      "ADG v2 is an automated integrity engine that verifies synchronization across human prose, machine-derived witness manifests (adg.manifest.json), and executable test invariants in tests/invariants/ to eliminate documentation and architectural drift.",
  },
  {
    question: "What is the Sapphire Shield governance system?",
    answer:
      "Sapphire Shield is a zero-trust capability intercept gate. It flags high-consequence operations (shell commands, budget spending, code mutation) for cryptographic human operator approval before execution, logging immutable SHA-256 Merkle audit chains.",
  },
  {
    question: "What platforms and operating systems are supported?",
    answer:
      "AI-Tadpole-OS provides self-contained release bundles for Windows 11 (x64 setup executable), macOS 13+ Universal (Apple Silicon M1-M4 & Intel x86_64 DMG), and Linux (Ubuntu 22.04+ .deb and portable binaries), requiring 16 GB RAM and 4+ CPU cores.",
  },
];
---

<BaseLayout
  title="AI-Tadpole-OS | Local-First Multi-Agent Swarm Runtime"
  description="AI-Tadpole-OS is a local-first Rust and React runtime for sovereign multi-agent orchestration, live telemetry, model routing, and human-governed execution."
  faqSchema={homeFaqSchema}
>
  <main id="main" class="homepage relative z-10" x-data="homepage()">
    <Hero />
    <ArchitectureLayers />
    <ScreenshotGallery />
    <TemplateCatalog />
    <Roadmap />
    <FaqSection faqs={homeFaqSchema} />
    <BottomCta />
    <LightboxModal />
  </main>
</BaseLayout>
