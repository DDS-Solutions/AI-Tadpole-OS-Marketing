---
import BaseLayout from "../layouts/BaseLayout.astro";
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<style>
  [x-cloak] { display: none !important; }
  .terminal-font {
    font-family: "JetBrains Mono", monospace;
  }
  
  .terminal-scroll::-webkit-scrollbar {
    width: 6px;
  }
  .terminal-scroll::-webkit-scrollbar-track {
    background: rgba(0, 0, 0, 0.4);
  }
  .terminal-scroll::-webkit-scrollbar-thumb {
    background: rgba(16, 185, 129, 0.3);
    border-radius: 3px;
  }

  .scanline {
    background: linear-gradient(
      to bottom,
      rgba(255,255,255,0),
      rgba(255,255,255,0) 50%,
      rgba(16, 185, 129, 0.02) 50%,
      rgba(16, 185, 129, 0.02)
    );
    background-size: 100% 4px;
  }
</style>

<BaseLayout
  title="Mission Runtime Experience | AI-Tadpole-OS Sovereign Protocol"
  description="Explore authentic screenshots and step-by-step walkthrough of the AI-Tadpole-OS mission runtime, captured directly from the live React desktop engine."
>
  <main
    id="main"
    class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 py-20 md:py-28 space-y-20"
    x-data="missionPage()"
  >
    <!-- Page Header -->
    <header class="text-center space-y-6 max-w-4xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-emerald-500/20 bg-emerald-500/10 text-emerald-400 font-mono text-xs uppercase tracking-widest backdrop-blur">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
        Live Desktop Runtime Walkthrough
      </div>
      <h1 class="text-5xl sm:text-7xl lg:text-8xl font-extrabold tracking-tight text-white font-outfit leading-[0.95]">
        Sovereign Swarm <span class="bg-gradient-to-r from-emerald-400 via-teal-300 to-cyan-400 bg-clip-text text-transparent">Missions</span>
      </h1>
      <p class="text-base sm:text-lg text-zinc-400 font-light leading-relaxed max-w-2xl mx-auto">
        Step inside the authentic <strong>Tadpole OS Runtime</strong> captured
        from <code class="text-emerald-400 font-mono text-xs bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20">http://localhost:5173/missions</code>.
        Witness multi-agent orchestration, OTel neural traces, and zero-trust execution controls.
      </p>
    </header>

    <!-- SECTION 1: REAL UI SLIDESHOW SHOWCASE -->
    <section class="glass-surface rounded-3xl border border-white/10 overflow-hidden shadow-2xl relative scanline p-6 sm:p-8 space-y-8">
      
      <!-- Top Title & Controls -->
      <div class="flex flex-wrap items-center justify-between gap-4 border-b border-white/10 pb-6">
        <div>
          <div class="flex items-center gap-3">
            <h2 class="text-2xl font-bold text-white font-outfit">Live Application Walkthrough</h2>
            <span class="px-2.5 py-0.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-[10px] font-mono font-bold uppercase tracking-wider">
              6 Real Screenshots
            </span>
          </div>
          <p class="text-xs text-zinc-400 mt-1 font-mono">
            Captured directly from the local React + Rust desktop engine.
          </p>
        </div>

        <div class="flex items-center gap-3 font-mono text-xs">
          <!-- Auto-Play Toggle -->
          <button
            @click="toggleAutoPlay()"
            :class="autoPlay ? 'border-emerald-500/40 bg-emerald-500/10 text-emerald-300' : 'border-white/10 bg-black/40 text-zinc-400'"
            class="px-3.5 py-2 rounded-xl border transition-all flex items-center gap-2 cursor-pointer"
          >
            <span x-text="autoPlay ? '⏸ Pause Slideshow' : '▶ Auto-Play Slideshow'">⏸ Pause Slideshow</span>
          </button>

          <!-- Prev/Next -->
          <div class="flex items-center gap-1.5 bg-black/40 p-1 rounded-xl border border-white/10">
            <button
              @click="prevSlide()"
              class="px-3 py-1.5 rounded-lg hover:bg-white/10 text-white font-bold transition-colors cursor-pointer"
              title="Previous slide (Left Arrow)"
            >
              ← Prev
            </button>
            <span class="text-zinc-500 px-2 font-mono" x-text="(currentSlide + 1) + ' / ' + slides.length">1 / 6</span>
            <button
              @click="nextSlide()"
              class="px-3 py-1.5 rounded-lg hover:bg-white/10 text-white font-bold transition-colors cursor-pointer"
              title="Next slide (Right Arrow)"
            >
              Next →
            </button>
          </div>
        </div>
      </div>

      <!-- Slide Nav Tabs -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2 font-mono text-xs">
        <template x-for="(slide, idx) in slides" :key="idx">
          <button
            @click="setSlide(idx)"
            :class="currentSlide === idx ? 'border-emerald-500/60 bg-emerald-500/10 text-white shadow-[0_0_15px_rgba(16,185,129,0.15)] font-bold' : 'border-white/5 bg-black/30 text-zinc-400 hover:border-white/15 hover:text-zinc-200'"
            class="p-3 rounded-xl border text-left transition-all duration-200 space-y-1 cursor-pointer"
          >
            <div class="text-[10px] text-zinc-500 uppercase tracking-widest" x-text="'STEP 0' + (idx + 1)"></div>
            <div class="text-xs truncate font-outfit font-semibold" x-text="slide.shortTitle"></div>
          </button>
        </template>
      </div>

      <!-- Main Active Slide Display -->
      <div class="grid lg:grid-cols-12 gap-8 items-start pt-2">
        <!-- Screenshot Container (8 cols) -->
        <div class="lg:col-span-8 space-y-4">
          <div class="relative group rounded-2xl overflow-hidden border border-white/15 shadow-2xl bg-black">
            <!-- Actual Screenshot Image -->
            <img
              src={`${basePath}/assets/real_mission/step1_initial_state.png`}
              alt="Swarm & Cluster Initialization"
              :src="slides[currentSlide].image"
              :alt="slides[currentSlide].title"
              class="w-full h-auto object-cover rounded-2xl transition-transform duration-500 group-hover:scale-[1.01] cursor-pointer"
              loading="eager"
              @click="openLightbox(slides[currentSlide].image)"
            />

            <!-- Lightbox Zoom Overlay Hint -->
            <button
              @click="openLightbox(slides[currentSlide].image)"
              class="absolute bottom-4 right-4 bg-zinc-950/85 hover:bg-zinc-950 border border-white/20 text-white px-3 py-1.5 rounded-lg text-xs font-mono flex items-center gap-1.5 opacity-90 hover:opacity-100 transition-all backdrop-blur cursor-pointer shadow-lg"
            >
              <span>🔍 Zoom Full Resolution</span>
            </button>
          </div>

          <!-- Progress Bar for Auto Play -->
          <div x-show="autoPlay" class="h-1 bg-zinc-900 rounded-full overflow-hidden border border-white/5">
            <div
              class="h-full bg-emerald-400 transition-all duration-100 ease-linear"
              :style="'width: ' + autoPlayProgress + '%'"
            ></div>
          </div>
        </div>

        <!-- Slide Detail Sidebar (4 cols) -->
        <div class="lg:col-span-4 space-y-6 glass-surface p-6 rounded-2xl border border-white/10 bg-black/40">
          <div class="space-y-2">
            <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 font-mono text-[10px] uppercase font-bold">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
              <span x-text="slides[currentSlide].badge">Phase 1: Cluster Initialization</span>
            </div>
            <h3 class="text-2xl font-bold text-white font-outfit" x-text="slides[currentSlide].title">Swarm &amp; Cluster Initialization</h3>
          </div>

          <p class="text-sm text-zinc-300 font-light leading-relaxed" x-text="slides[currentSlide].description">The OS scans active swarm clusters. The Strategic Command cluster is initialized with 60 nodes online and a $100.00 execution budget.</p>

          <div class="space-y-3 pt-3 border-t border-white/10 font-mono text-xs">
            <div class="text-zinc-500 font-bold uppercase text-[10px] tracking-wider">Protocol Verification Metrics</div>
            
            <div class="flex justify-between items-center py-1.5 border-b border-white/5">
              <span class="text-zinc-400" x-text="slides[currentSlide].metrics[0].label">Active Swarm Clusters</span>
              <span class="text-emerald-300 font-bold" x-text="slides[currentSlide].metrics[0].value">4 / 5 Online</span>
            </div>
            <div class="flex justify-between items-center py-1.5 border-b border-white/5">
              <span class="text-zinc-400" x-text="slides[currentSlide].metrics[1].label">Swarm Node Density</span>
              <span class="text-emerald-300 font-bold" x-text="slides[currentSlide].metrics[1].value">60 Nodes</span>
            </div>
            <div class="flex justify-between items-center py-1.5 border-b border-white/5">
              <span class="text-zinc-400" x-text="slides[currentSlide].metrics[2].label">Target Workspace</span>
              <span class="text-emerald-300 font-bold" x-text="slides[currentSlide].metrics[2].value">/workspaces/strategic-command</span>
            </div>
          </div>

          <div class="p-3.5 rounded-xl bg-zinc-950/80 border border-white/10 font-mono text-xs text-zinc-400 space-y-1">
            <div class="text-[10px] text-zinc-500 uppercase font-bold">Real Telemetry Log Snippet</div>
            <div class="text-emerald-400/90 leading-relaxed font-mono text-[11px]" x-html="slides[currentSlide].logSnippet"><span class="text-cyan-400">[INIT]</span> Swarm Cluster Strategic Command mounted. 60 Nodes initialized.</div>
          </div>
        </div>
      </div>

    </section>

    <!-- LIGHTBOX MODAL FOR FULL RESOLUTION SCREENSHOTS -->
    <div
      x-show="lightboxOpen"
      x-cloak
      x-transition:enter="transition ease-out duration-300"
      x-transition:enter-start="opacity-0 scale-95"
      x-transition:enter-end="opacity-100 scale-100"
      x-transition:leave="transition ease-in duration-200"
      x-transition:leave-start="opacity-100 scale-100"
      x-transition:leave-end="opacity-0 scale-95"
      class="fixed inset-0 z-[100] bg-black/95 backdrop-blur-2xl flex flex-col items-center justify-center p-4 sm:p-6"
      @click="closeLightbox()"
      @keydown.escape.window="closeLightbox()"
      role="dialog"
      aria-modal="true"
      aria-labelledby="mission-lightbox-title"
    >
      <!-- Top Floating Controls Header -->
      <div class="w-full max-w-6xl flex items-center justify-between pb-4 font-mono text-xs z-10" @click.stop>
        <div class="flex items-center gap-2 text-zinc-400">
          <span id="mission-lightbox-title" class="text-emerald-400 font-bold">🔍 High-Resolution Preview</span>
          <span class="text-zinc-600">|</span>
          <span class="text-zinc-500">Press ESC or click anywhere to exit</span>
        </div>

        <button
          @click="closeLightbox()"
          x-ref="closeButton"
          class="px-4 py-2 bg-emerald-500 hover:bg-emerald-400 text-zinc-950 font-bold rounded-xl border border-emerald-400 shadow-xl transition-all hover:scale-105 active:scale-95 cursor-pointer flex items-center gap-2"
        >
          <span>✕</span> Close Full Screen
        </button>
      </div>

      <!-- Image Container -->
      <div class="relative max-w-6xl max-h-[82vh] flex items-center justify-center overflow-hidden rounded-2xl border border-white/20 shadow-2xl bg-zinc-950" @click.stop>
        <img
          :src="lightboxImg"
          class="max-h-[82vh] max-w-full w-auto h-auto object-contain rounded-2xl select-none"
          alt="Full Resolution Screenshot"
        />
      </div>
    </div>

  </main>
</BaseLayout>
