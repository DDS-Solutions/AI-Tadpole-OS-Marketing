---
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section
  class="relative min-h-[90vh] overflow-hidden border-b border-white/10 pt-28 scanline-bg flex flex-col justify-between"
>
  <img
    src={`${basePath}/assets/real_os_dashboard.png`}
    alt=""
    width="1662"
    height="905"
    class="absolute inset-0 h-full w-full object-cover opacity-20"
    loading="eager"
    decoding="async"
    fetchpriority="high"
  />
  <div
    class="absolute inset-0 bg-[linear-gradient(90deg,#09090b_0%,rgba(9,9,11,0.92)_42%,rgba(9,9,11,0.62)_100%)] pointer-events-none"
  >
  </div>
  <div
    class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-zinc-950 to-transparent pointer-events-none"
  >
  </div>

  <div
    class="relative mx-auto flex min-h-[calc(88vh-7rem)] max-w-7xl flex-col justify-center px-5 py-16 sm:px-8"
  >
    <div class="max-w-4xl space-y-8">
      <div
        class="inline-flex items-center gap-3 rounded-full border border-emerald-400/20 bg-zinc-950/80 px-4 py-1.5 font-mono text-xs font-bold uppercase tracking-widest text-emerald-300 backdrop-blur shadow-[0_0_20px_rgba(16,185,129,0.15)]"
      >
        <span class="h-2 w-2 rounded-full bg-emerald-400 animate-ping"></span>
        Local-First Sovereign Protocol Runtime
      </div>

      <div class="space-y-5">
        <h1
          class="text-6xl font-extrabold leading-[0.92] text-white sm:text-7xl lg:text-8xl font-outfit tracking-tight text-[var(--text-fluid-display)]"
        >
          AI-Tadpole-OS
        </h1>
        <p
          class="max-w-3xl text-xl leading-8 text-zinc-300 sm:text-2xl sm:leading-9 font-light"
        >
          A sovereign command layer for multi-agent work: <strong>Rust
          execution</strong>, <strong>React observability</strong>,
          <strong>private LanceDB memory</strong>, and <strong>human-governed
          automation</strong> in one local runtime.
        </p>
      </div>

      <div class="flex flex-wrap gap-4 pt-2 font-mono text-xs font-bold">
        <a
          href="https://github.com/DDS-Solutions/AI-TadPole-OS"
          class="px-8 py-4 bg-white text-zinc-950 rounded-xl hover:bg-zinc-200 transition-all duration-300 hover:scale-105 shadow-[0_0_25px_rgba(255,255,255,0.2)] uppercase tracking-wider"
        >
          Explore Source Repo
        </a>
        <a
          href={`${basePath}/mission`}
          class="px-8 py-4 bg-gradient-to-r from-emerald-500 to-teal-400 text-zinc-950 rounded-xl hover:from-emerald-400 hover:to-teal-300 transition-all duration-300 hover:scale-105 shadow-[0_0_25px_rgba(16,185,129,0.25)] uppercase tracking-wider"
        >
          ▶ Launch Mission Demo
        </a>
        <a
          href={`${basePath}/how-it-works`}
          class="px-8 py-4 border border-white/15 bg-white/5 text-zinc-100 rounded-xl hover:border-emerald-400 hover:text-emerald-300 transition-all duration-300 uppercase tracking-wider"
        >
          Architecture Specs ➔
        </a>
      </div>
    </div>
  </div>
</section>
