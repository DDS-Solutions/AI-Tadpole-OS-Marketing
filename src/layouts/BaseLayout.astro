---
import { ClientRouter } from "astro:transitions";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import BackgroundCanvas from "../components/layout/BackgroundCanvas.astro";
import "../styles/global.css";

export interface FaqItem {
  question: string;
  answer: string;
}

export interface ArticleMetadata {
  headline: string;
  description: string;
}

interface Props {
  title: string;
  description: string;
  keywords?: string;
  noIndex?: boolean;
  faqSchema?: FaqItem[];
  articleSchema?: ArticleMetadata;
}

const {
  title,
  description,
  keywords,
  noIndex = false,
  faqSchema,
  articleSchema,
} = Astro.props;

const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const siteRootUrl = new URL(`${basePath}/`, Astro.url.origin).href;
const canonicalPath = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonicalUrl = new URL(canonicalPath, Astro.url.origin).href;
const socialImageUrl = new URL(
  `${basePath}/assets/brand/ai-tadpole-os-social-card.jpg`,
  Astro.url.origin,
).href;

const defaultKeywords =
  "AI-Tadpole-OS, sovereign intelligence, local-first multi-agent runtime, agent swarm orchestration, Rust AI runtime, human-in-the-loop governance, LanceDB, Sapphire Shield, private memory";

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${siteRootUrl}#organization`,
  name: "DDS Solutions",
  url: "https://github.com/DDS-Solutions",
  logo: new URL(`${basePath}/assets/brand/tadpole-mark-192.png`, Astro.url.origin).href,
  sameAs: ["https://github.com/DDS-Solutions/AI-TadPole-OS"],
};

const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteRootUrl}#website`,
  url: siteRootUrl,
  name: "AI-Tadpole-OS",
  description:
    "A local-first, sovereign multi-agent runtime designed for high-performance orchestration and human-in-the-loop governance.",
  publisher: {
    "@id": `${siteRootUrl}#organization`,
  },
};

const softwareApplicationSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "@id": `${siteRootUrl}#software`,
  name: "AI-Tadpole-OS",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Windows, macOS, Linux",
  softwareVersion: "0.0.1",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  author: {
    "@type": "Organization",
    "@id": `${siteRootUrl}#organization`,
    name: "DDS Solutions",
    url: "https://github.com/DDS-Solutions",
  },
  description,
  url: siteRootUrl,
  sameAs: ["https://github.com/DDS-Solutions/AI-TadPole-OS"],
};

const routeSegment = Astro.url.pathname.replace(basePath, "").replace(/\//g, "");
const breadcrumbSchema = routeSegment
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: siteRootUrl,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: title.split("—")[0].split("|")[0].trim() || routeSegment,
          item: canonicalUrl,
        },
      ],
    }
  : null;

const formattedFaqSchema = faqSchema?.length
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faqSchema.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: item.answer,
        },
      })),
    }
  : null;

const formattedArticleSchema = articleSchema
  ? {
      "@context": "https://schema.org",
      "@type": "TechArticle",
      headline: articleSchema.headline,
      description: articleSchema.description,
      url: canonicalUrl,
      author: {
        "@type": "Organization",
        "@id": `${siteRootUrl}#organization`,
        name: "DDS Solutions",
      },
      publisher: {
        "@type": "Organization",
        "@id": `${siteRootUrl}#organization`,
        name: "DDS Solutions",
      },
      mainEntityOfPage: {
        "@type": "WebPage",
        "@id": canonicalUrl,
      },
    }
  : null;
---

<!doctype html>
<html lang="en" data-theme="zinc">
  <head>
    <meta
      name="google-site-verification"
      content="fZFIBOhQC_xJPk_Vt_iueDPpdufqV8XOqdifUtCu_dk"
    />
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords || defaultKeywords} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#09090b" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="AI-Tadpole-OS" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="AI-Tadpole-OS local-first multi-agent runtime" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content="AI-Tadpole-OS local-first multi-agent runtime" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" sizes="48x48" href={`${basePath}/assets/brand/tadpole-mark-48.png`} />
    <link rel="icon" type="image/png" sizes="96x96" href={`${basePath}/assets/brand/tadpole-mark-96.png`} />
    <link rel="apple-touch-icon" sizes="192x192" href={`${basePath}/assets/brand/tadpole-mark-192.png`} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ClientRouter />

    <meta name="ai-sovereign-os" content="AI-Tadpole-OS" />
    <meta
      name="ai-intelligence-category"
      content="Local-first multi-agent swarm runtime"
    />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(webSiteSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(softwareApplicationSchema)} />
    {breadcrumbSchema && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}
    {formattedFaqSchema && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(formattedFaqSchema)} />
    )}
    {formattedArticleSchema && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(formattedArticleSchema)} />
    )}

  </head>
  <body
    class="bg-zinc-950 text-zinc-100 font-inter antialiased selection:bg-emerald-500/30 overflow-x-hidden"
  >
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-white focus:px-4 focus:py-3 focus:text-sm focus:font-bold focus:text-zinc-950"
    >
      Skip to content
    </a>

    <Header />

    <BackgroundCanvas />

    <slot />

    <Footer />

    <script>
      import Alpine from "alpinejs";
      import { registerAlpineComponents } from "../scripts/alpine-stores";

      declare global {
        interface Window {
          Alpine: import("alpinejs").AlpineInstance;
        }
      }

      if (!window.Alpine) {
        window.Alpine = Alpine;
        registerAlpineComponents(Alpine);
        Alpine.start();
      }

      let cleanups: (() => void)[] = [];

      function setupVisuals() {
        cleanupVisuals();

        const prefersReducedMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        ).matches;
        if (prefersReducedMotion) return;

        // Observer for scroll animation reveals
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("active");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12 },
        );

        document.querySelectorAll("[data-reveal]").forEach((el) => {
          el.classList.add("reveal-on-scroll");
          observer.observe(el);
        });

        cleanups.push(() => {
          observer.disconnect();
        });

      }

      function cleanupVisuals() {
        cleanups.forEach((cleanup) => cleanup());
        cleanups = [];
      }

      function onPageLoad() {
        setupVisuals();
        if (window.Alpine) {
          window.Alpine.initTree(document.body);
        }
      }

      document.addEventListener("astro:page-load", onPageLoad);
      document.addEventListener("astro:before-swap", cleanupVisuals);
    </script>
  </body>
</html>
