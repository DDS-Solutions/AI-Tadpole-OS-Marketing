---
interface Props {
  titleId?: string;
  titleText?: string;
  width?: number;
  height?: number;
}

const {
  titleId = "homepage-lightbox-title",
  titleText = "Interface preview",
  width = 1680,
  height = 1050,
} = Astro.props;
---

<div
  x-show="lightboxOpen"
  x-cloak
  x-ref="dialog"
  x-transition:enter="transition ease-out duration-300"
  x-transition:enter-start="opacity-0 scale-95"
  x-transition:enter-end="opacity-100 scale-100"
  x-transition:leave="transition ease-in duration-200"
  x-transition:leave-start="opacity-100 scale-100"
  x-transition:leave-end="opacity-0 scale-95"
  class="fixed inset-0 z-[100] bg-black/95 backdrop-blur-2xl flex flex-col items-center justify-center p-4 sm:p-6"
  @click="closeLightbox()"
  @keydown.escape.window="closeLightbox()"
  @keydown.tab="trapLightboxFocus($event)"
  role="dialog"
  aria-modal="true"
  aria-labelledby={titleId}
  :aria-hidden="!lightboxOpen"
>
  <!-- Top Floating Controls Header -->
  <div
    class="w-full max-w-6xl flex items-center justify-between gap-4 pb-4 text-xs z-10"
    @click.stop
  >
    <div class="min-w-0 flex flex-wrap items-center gap-2 text-zinc-400">
      <span id={titleId} class="text-emerald-400 font-bold"
        >{titleText}</span
      >
      <span class="hidden text-zinc-600 sm:inline" aria-hidden="true">|</span>
      <span class="hidden text-zinc-400 sm:inline">Press Escape or click the backdrop to close</span>
    </div>

    <button
      type="button"
      @click="closeLightbox()"
      x-ref="closeButton"
      class="min-h-11 shrink-0 px-4 py-2 bg-emerald-300 hover:bg-emerald-200 text-zinc-950 font-medium rounded-lg border border-emerald-200 cursor-pointer flex items-center gap-2"
    >
      <span aria-hidden="true">×</span> Close preview
    </button>
  </div>

  <!-- Image Container -->
  <div
    class="relative max-w-6xl max-h-[82vh] flex items-center justify-center overflow-hidden rounded-2xl border border-white/20 shadow-2xl bg-zinc-950"
    @click.stop
  >
    <img
      :src="lightboxImg"
      :alt="lightboxAlt"
      width={width}
      height={height}
      class="max-h-[82vh] max-w-full w-auto h-auto object-contain rounded-2xl select-none"
    />
  </div>
</div>
