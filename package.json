  },
  "dependencies": {
    "alpinejs": "^3.17.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
