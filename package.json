{
  "name": "tadpole-marketing",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/generate_sitemap.js",
    "check": "astro check",
    "typecheck": "tsc --noEmit",
    "preview": "astro preview",
    "astro": "astro",
    "test:unit": "node --test tests/tokens_and_components.test.js",
