---
import StatusBadge from "./StatusBadge.astro";

interface Props {
  tag?: string;
  tagVariant?: "emerald" | "cyan" | "purple" | "amber" | "red";
  title: string;
  subtitle?: string;
  align?: "left" | "center";
  class?: string;
}

const {
  tag,
  tagVariant = "emerald",
  title,
  subtitle,
  align = "center",
  class: className = "",
} = Astro.props;
---

<div
  class:list={[
    "mb-12",
    align === "center" ? "text-center" : "text-left",
    className,
  ]}
>
  {tag && (
    <div class="mb-4">
      <StatusBadge variant={tagVariant} pulse={true}>
        {tag}
      </StatusBadge>
    </div>
  )}
  <h2 class="text-3xl font-extrabold tracking-tight sm:text-4xl text-white text-[var(--text-fluid-title)]">
    {title}
  </h2>
  {subtitle && (
    <p
      class:list={[
        "mt-4 text-zinc-400 leading-relaxed text-[var(--text-fluid-body)]",
        align === "center" ? "mx-auto max-w-2xl" : "max-w-2xl",
      ]}
    >
      {subtitle}
    </p>
  )}
</div>
