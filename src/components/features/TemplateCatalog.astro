---
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section
  id="templates"
  class="scroll-mt-28 mx-auto max-w-7xl px-5 sm:px-8 space-y-12"
>
  <div class="text-center space-y-4 max-w-3xl mx-auto">
    <span
      class="font-mono text-xs font-bold uppercase tracking-widest text-emerald-400"
    >
      Declarative Swarm Library
    </span>
    <h2
      class="text-4xl font-bold leading-tight text-white sm:text-5xl font-outfit text-[var(--text-fluid-title)]"
    >
      223 Specialized Agent Roles Across 25 Industries
    </h2>
    <p class="text-lg leading-8 text-zinc-400 font-light text-[var(--text-fluid-body)]">
      Search, customize, and deploy pre-configured agent roles from 25
      industry template collections.
    </p>
  </div>

  <!-- SWARM CATALOG UI FEATURE HIGHLIGHT BOX -->
  <div
    class="glass-surface p-8 sm:p-10 rounded-3xl border border-emerald-500/30 bg-gradient-to-r from-emerald-950/40 via-zinc-950 to-cyan-950/40 grid lg:grid-cols-[1.2fr_0.8fr] gap-8 items-center shadow-2xl"
  >
    <div class="space-y-5">
      <div
        class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 font-mono text-xs font-bold uppercase"
      >
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
        Browse Industry Agent Catalog
      </div>
      <h3
        class="text-3xl sm:text-4xl font-extrabold text-white font-outfit text-[var(--text-fluid-title)]"
      >
        223 Specialized Agent Roles Across 25 Industries
      </h3>
      <p class="text-zinc-300 text-sm font-light leading-relaxed">
        Need specialized industry workflows? Access our official community
        catalog containing <strong>223 specialized agent roles</strong>
        across <strong>25 industry template collections</strong>, including
        Engineering, Security, GIS, Marketing, Finance, Spatial Computing,
        and Academic workflows. Search
        by role, inspect full system directives, and add personas directly
        to your local swarm roster.
      </p>
      <div class="pt-2 font-mono text-xs">
        <a
          href="https://dds-solutions.github.io/AI-Tadpole-OS-Industry-Templates/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3.5 bg-gradient-to-r from-emerald-500 to-teal-400 text-zinc-950 rounded-xl hover:from-emerald-400 hover:to-teal-300 font-bold uppercase tracking-wider transition-all duration-300 hover:scale-105 shadow-[0_0_25px_rgba(16,185,129,0.3)] cursor-pointer"
        >
          <span>🛠️ Browse Live Agent Catalog (223 Roles)</span>
          <span>➔</span>
        </a>
      </div>
    </div>

    <div
      class="relative rounded-2xl overflow-hidden border border-white/15 shadow-2xl group bg-black"
    >
      <img
        src={`${basePath}/assets/industry_templates_catalog.png`}
        alt="Browse Agent Swarm Catalog UI"
        width="1680"
        height="1050"
        loading="lazy"
        decoding="async"
        class="w-full h-auto object-cover group-hover:scale-[1.02] transition-transform duration-500"
      />
      <button
        type="button"
        @click={`openLightbox('${basePath}/assets/industry_templates_catalog.png', 'Industry agent swarm catalog')`}
        class="absolute bottom-3 right-3 bg-zinc-950/85 hover:bg-zinc-950 border border-white/20 text-white px-3 py-1.5 rounded-lg text-xs font-mono flex items-center gap-1.5 opacity-90 hover:opacity-100 transition-all backdrop-blur shadow-lg cursor-pointer"
      >
        <span>🔍 Zoom Full Resolution</span>
      </button>
    </div>
  </div>

  <div class="grid md:grid-cols-3 gap-6 font-mono text-xs">
    <!-- Template Card 1 -->
    <div
      class="glass-surface p-6 rounded-2xl border border-emerald-500/30 space-y-4 hover:border-emerald-500 transition-all"
    >
      <div class="flex items-center justify-between">
        <span class="text-emerald-400 font-bold uppercase text-[10px]"
          >Security & Audit</span
        >
        <span
          class="px-2 py-0.5 rounded bg-emerald-500/10 border border-emerald-500/20 text-emerald-300 text-[10px]"
          >10 Agents</span
        >
      </div>
      <h3 class="text-xl font-bold text-white font-outfit">
        Codebase FFI Vulnerability Sentinel
      </h3>
      <p class="text-zinc-400 text-xs font-light leading-relaxed">
        Scans Rust/C FFI boundaries, checks memory safety invariants, and
        logs cryptographic Merkle proof receipts.
      </p>
      <div
        class="p-3 rounded bg-zinc-950 border border-white/5 text-[11px] text-zinc-400"
      >
        Tools: <span class="text-white"
          >grep_search, adg01_symbol_gate, merkele_audit</span
        >
      </div>
    </div>

    <!-- Template Card 2 -->
    <div
      class="glass-surface p-6 rounded-2xl border border-cyan-500/30 space-y-4 hover:border-cyan-500 transition-all"
    >
      <div class="flex items-center justify-between">
        <span class="text-cyan-400 font-bold uppercase text-[10px]"
          >Engineering & GIS</span
        >
        <span
          class="px-2 py-0.5 rounded bg-cyan-500/10 border border-cyan-500/20 text-cyan-300 text-[10px]"
          >46 Agents</span
        >
      </div>
      <h3 class="text-xl font-bold text-white font-outfit">
        GraphRAG Knowledge Indexer
      </h3>
      <p class="text-zinc-400 text-xs font-light leading-relaxed">
        Parses multi-file AST graphs, computes 768-dim LanceDB embeddings,
        and updates Institutional Knowledge Store (IKS).
      </p>
      <div
        class="p-3 rounded bg-zinc-950 border border-white/5 text-[11px] text-zinc-400"
      >
        Tools: <span class="text-white"
          >lancedb_vector, ast_parser, graph_rag_query</span
        >
      </div>
    </div>

    <!-- Template Card 3 -->
    <div
      class="glass-surface p-6 rounded-2xl border border-purple-500/30 space-y-4 hover:border-purple-500 transition-all"
    >
      <div class="flex items-center justify-between">
        <span class="text-purple-400 font-bold uppercase text-[10px]"
          >Specialized & Operations</span
        >
        <span
          class="px-2 py-0.5 rounded bg-purple-500/10 border border-purple-500/20 text-purple-300 text-[10px]"
          >53 Agents</span
        >
      </div>
      <h3 class="text-xl font-bold text-white font-outfit">
        Self-Annealing Operations Synthesizer
      </h3>
      <p class="text-zinc-400 text-xs font-light leading-relaxed">
        Decomposes high-level strategic directives, monitors 10Hz telemetry
        streams, and executes self-correction loops.
      </p>
      <div
        class="p-3 rounded bg-zinc-950 border border-white/5 text-[11px] text-zinc-400"
      >
        Tools: <span class="text-white"
          >agent_99_router, sapphire_shield, telemetry_pulse</span
        >
      </div>
    </div>
  </div>
</section>
