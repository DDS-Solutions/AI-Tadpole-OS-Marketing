{
  "name": "tadpole-marketing",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/generate_sitemap.js",
    "check": "astro check",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check \"src/**/*.{ts,js,astro,css}\" \"scripts/**/*.{js,mjs}\" \"tests/**/*.js\"",
    "format": "prettier --write \"src/**/*.{ts,js,astro,css}\" \"scripts/**/*.{js,mjs}\" \"tests/**/*.js\"",
    "preview": "astro preview",
    "astro": "astro",
    "test:unit": "node --experimental-strip-types --test tests/*.test.js",
    "test:static": "node scripts/verify_site.js",
    "test:browser": "node scripts/verify_browser.js",
    "test:built": "npm run test:unit && npm run test:static && npm run test:browser",
    "test": "npm run build && npm run test:built"
  },
  "dependencies": {
    "alpinejs": "^3.17.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@tailwindcss/vite": "^4.3.3",
    "@types/alpinejs": "^3.17.0",
    "astro": "^7.4.5",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
