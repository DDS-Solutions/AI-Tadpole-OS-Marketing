---
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="section-shell">
    <div class="footer-main">
      <div class="footer-brand">
        <a href={`${basePath}/`} aria-label="AI-Tadpole-OS home"
          ><img
            src={`${basePath}/assets/brand/tadpole-mark-96.png`}
            alt=""
            width="96"
            height="96"
            loading="lazy"
            decoding="async"
          /><span>AI-Tadpole-OS<span class="footer-os"></span></span></a
        >
        <p>
          Intelligence on your terms.<br />A local-first runtime for governed AI
          agents.
        </p>
      </div>
      <nav aria-label="Footer product navigation">
        <span>EXPLORE</span><a href={`${basePath}/how-it-works/`}
          >Architecture</a
        ><a href={`${basePath}/mission/`}>Mission walkthrough</a><a
          href={`${basePath}/governance/`}>Governance</a>
      </nav>
      <nav aria-label="Footer resources">
        <span>BUILD</span><a
          href="https://github.com/DDS-Solutions/AI-TadPole-OS"
          >Source on GitHub <span aria-hidden="true">↗</span></a
        ><a
          href="https://dds-solutions.github.io/AI-Tadpole-OS-Industry-Templates/"
          >Agent catalog <span aria-hidden="true">↗</span></a
        ><a href={`${basePath}/#roadmap`}>Engineering direction</a>
      </nav>
    </div>
    <div class="footer-bottom">
      <p>© {year} DDS Solutions · AI-Tadpole-OS</p><span
        ><span class="status-dot"></span> Built for sovereignty.</span
      ><a href="#main">Back to top <span aria-hidden="true">↑</span></a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: 10;
    border-top: 1px solid var(--line);
    background: #090b0ce8;
    padding: 3.5rem 0 0;
  }
  .footer-main {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 3rem;
    padding-bottom: 3rem;
  }
  .footer-brand > a {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 44px;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .footer-brand img {
    width: 30px;
    height: 30px;
    border-radius: 8px;
    border: 1px solid #ffffff15;
  }
  .footer-os {
    font-weight: 400;
    color: #a1a1aa;
  }
  .footer-brand p {
    font-size: 0.75rem;
    color: #a1a1aa;
    line-height: 1.9;
    margin-top: 0.9rem;
  }
  nav {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  nav > span {
    font: 0.55rem var(--font-mono);
    letter-spacing: 0.15em;
    color: #a1a1aa;
    margin-bottom: 0.75rem;
  }
  nav a {
    display: inline-flex;
    min-height: 38px;
    align-items: center;
    gap: 0.5rem;
    color: #b5bdb9;
    font-size: 0.75rem;
  }
  nav a:hover {
    color: #a7f3d0;
  }
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid var(--line);
    padding: 1.25rem 0;
    font-size: 0.6rem;
    color: #a1a1aa;
  }
  .footer-bottom > span {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .footer-bottom a {
    min-height: 32px;
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
  }
  @media (max-width: 639px) {
    .footer-main {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
    .footer-bottom > span {
      display: none;
    }
  }
</style>
