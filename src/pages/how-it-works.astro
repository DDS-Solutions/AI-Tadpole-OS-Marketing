---
import BaseLayout from "../layouts/BaseLayout.astro";
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<style>
  [x-cloak] {
    display: none !important;
  }
  .font-mono-code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  .neural-pulse-line {
    stroke-dasharray: 20;
    animation: dashPulse 2s linear infinite;
  }
  @keyframes dashPulse {
    to {
      stroke-dashoffset: -40;
    }
  }

  .scanline-bg {
    background: linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0),
      rgba(255, 255, 255, 0) 50%,
      rgba(16, 185, 129, 0.02) 50%,
      rgba(16, 185, 129, 0.02)
    );
    background-size: 100% 4px;
  }

  .glow-box-emerald {
    box-shadow: 0 0 30px rgba(16, 185, 129, 0.15);
  }
</style>

<BaseLayout
  title="Engine Mechanics & Architecture | AI-Tadpole-OS Sovereign Protocol"
  description="Deep-dive into the AI-Tadpole-OS technical architecture: 3-layer orchestration stack, Rust Axum/Tokio execution engine, Sapphire Shield zero-trust HITL gate, and LanceDB GraphRAG memory."
>
  <main
    id="main"
    class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 py-20 md:py-28 space-y-24"
    x-data="howItWorksPage()"
  >
    <!-- Header -->
    <header class="text-center space-y-6 max-w-4xl mx-auto">
      <div
        class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-emerald-500/20 bg-emerald-500/10 text-emerald-400 font-mono text-xs uppercase tracking-widest backdrop-blur"
      >
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
        Technical Architecture & Mechanics
      </div>
      <h1
        class="text-5xl sm:text-7xl lg:text-8xl font-extrabold tracking-tight text-white font-outfit leading-[0.95]"
      >
        High-Fidelity <span
          class="bg-gradient-to-r from-emerald-400 via-teal-300 to-cyan-400 bg-clip-text text-transparent"
          >Architecture</span
        >
      </h1>
      <p
        class="text-base sm:text-lg text-zinc-400 font-light leading-relaxed max-w-2xl mx-auto"
      >
        A comprehensive technical deep-dive into the sovereign engine:
        <strong>3-Layer Separation of Concerns</strong>, <strong>Axum/Tokio
        Async Execution</strong>, <strong>Sapphire Shield Governance</strong>,
        and <strong>LanceDB GraphRAG Memory</strong>.
      </p>
    </header>

    <!-- INTERACTIVE ARCHITECTURE EXPLORER HUD -->
    <section
      class="glass-surface rounded-3xl border border-white/10 overflow-hidden shadow-2xl p-6 sm:p-10 space-y-8 scanline-bg glow-box-emerald"
    >
      <div
        class="flex flex-wrap items-center justify-between gap-4 border-b border-white/10 pb-6"
      >
        <div>
          <div class="flex items-center gap-3">
            <span class="text-2xl">⚙️</span>
            <h2 class="text-2xl font-bold text-white font-outfit">
              Sovereign Protocol Core Stack
            </h2>
          </div>
          <p class="text-xs text-zinc-400 mt-1 font-mono">
            Click any component below to inspect runtime specs, data flows, and
            code contracts.
          </p>
        </div>

        <div
          class="flex items-center gap-2 font-mono text-xs text-emerald-400 bg-emerald-500/10 px-3 py-1.5 rounded-xl border border-emerald-500/20"
        >
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
          <span>Version 1.1.427 Reference</span>
        </div>
      </div>

      <!-- Interactive 5-Component Architecture Pipeline -->
      <div
        class="grid grid-cols-1 md:grid-cols-5 gap-3 font-mono text-xs"
        role="tablist"
        aria-label="Architecture pipeline layers"
        @keydown.right.prevent="moveNodeFocus(1)"
        @keydown.left.prevent="moveNodeFocus(-1)"
        @keydown.home.prevent="focusNodeBoundary('first')"
        @keydown.end.prevent="focusNodeBoundary('last')"
      >
        <button
          type="button"
          id="arch-tab-directive"
          @click="selectNode('directive')"
          role="tab"
          aria-controls="arch-panel"
          :aria-selected="selectedNode === 'directive'"
          :tabindex="selectedNode === 'directive' ? 0 : -1"
          :class="getNodeClass('directive')"
          class="p-4 rounded-2xl border text-left transition-all duration-200 space-y-2 relative overflow-hidden group cursor-pointer"
        >
          <div
            class="text-[10px] text-emerald-400 font-bold uppercase tracking-widest"
          >
            Layer 1
          </div>
          <div class="text-sm font-bold text-white font-outfit">
            Directives SOP
          </div>
          <div class="text-[11px] text-zinc-400 font-light">
            Markdown SOPs & YAML Parameters
          </div>
        </button>

        <button
          type="button"
          id="arch-tab-orchestration"
          @click="selectNode('orchestration')"
          role="tab"
          aria-controls="arch-panel"
          :aria-selected="selectedNode === 'orchestration'"
          :tabindex="selectedNode === 'orchestration' ? 0 : -1"
          :class="getNodeClass('orchestration')"
          class="p-4 rounded-2xl border text-left transition-all duration-200 space-y-2 relative overflow-hidden group cursor-pointer"
        >
          <div
            class="text-[10px] text-purple-400 font-bold uppercase tracking-widest"
          >
            Layer 2
          </div>
          <div class="text-sm font-bold text-white font-outfit">
            Agent 99 Router
          </div>
          <div class="text-[11px] text-zinc-400 font-light">
            Tri-Slot Fallback & Swarm Hierarchy
          </div>
        </button>

        <button
          type="button"
          id="arch-tab-execution"
          @click="selectNode('execution')"
          role="tab"
          aria-controls="arch-panel"
          :aria-selected="selectedNode === 'execution'"
          :tabindex="selectedNode === 'execution' ? 0 : -1"
          :class="getNodeClass('execution')"
          class="p-4 rounded-2xl border text-left transition-all duration-200 space-y-2 relative overflow-hidden group cursor-pointer"
        >
          <div
            class="text-[10px] text-cyan-400 font-bold uppercase tracking-widest"
          >
            Layer 3
          </div>
          <div class="text-sm font-bold text-white font-outfit">
            Rust Core Engine
          </div>
          <div class="text-[11px] text-zinc-400 font-light">
            Axum/Tokio & FuturesUnordered
          </div>
        </button>

        <button
          type="button"
          id="arch-tab-governance"
          @click="selectNode('governance')"
          role="tab"
          aria-controls="arch-panel"
          :aria-selected="selectedNode === 'governance'"
          :tabindex="selectedNode === 'governance' ? 0 : -1"
          :class="getNodeClass('governance')"
          class="p-4 rounded-2xl border text-left transition-all duration-200 space-y-2 relative overflow-hidden group cursor-pointer"
        >
          <div
            class="text-[10px] text-amber-400 font-bold uppercase tracking-widest"
          >
            Governance
          </div>
          <div class="text-sm font-bold text-white font-outfit">
            Sapphire Shield
          </div>
          <div class="text-[11px] text-zinc-400 font-light">
            Zero-Trust HITL & Merkle Proofs
          </div>
        </button>

        <button
          type="button"
          id="arch-tab-memory"
          @click="selectNode('memory')"
          role="tab"
          aria-controls="arch-panel"
          :aria-selected="selectedNode === 'memory'"
          :tabindex="selectedNode === 'memory' ? 0 : -1"
          :class="getNodeClass('memory')"
          class="p-4 rounded-2xl border text-left transition-all duration-200 space-y-2 relative overflow-hidden group cursor-pointer"
        >
          <div
            class="text-[10px] text-blue-400 font-bold uppercase tracking-widest"
          >
            Memory Store
          </div>
          <div class="text-sm font-bold text-white font-outfit">
            LanceDB GraphRAG
          </div>
          <div class="text-[11px] text-zinc-400 font-light">
            IKS Vectors & 768-dim Embeddings
          </div>
        </button>
      </div>

      <!-- Node Technical Spec Detail Card -->
      <div
        id="arch-panel"
        role="tabpanel"
        :aria-labelledby="'arch-tab-' + selectedNode"
        tabindex="0"
        class="p-6 sm:p-8 rounded-2xl bg-zinc-950/90 border border-white/10 space-y-6"
      >
        <div
          class="flex flex-wrap items-center justify-between gap-4 border-b border-white/10 pb-4"
        >
          <div class="flex items-center gap-3">
            <span class="text-3xl" x-text="nodes[selectedNode].icon">📜</span>
            <div>
              <h3
                class="text-2xl font-bold text-white font-outfit"
                x-text="nodes[selectedNode].title"
              >Directives SOP</h3>
              <p
                class="text-xs font-mono text-emerald-400"
                x-text="nodes[selectedNode].subTitle"
              >Layer 1: Instruction Set</p>
            </div>
          </div>

          <span
            class="px-3 py-1 rounded-full bg-white/5 border border-white/10 font-mono text-xs text-zinc-300 font-bold"
            x-text="nodes[selectedNode].badge">INPUT_LAYER</span>
        </div>

        <p
          class="text-base text-zinc-300 font-light leading-relaxed"
          x-text="nodes[selectedNode].description"
        >The entry point of the sovereign engine. Directives are authored in Markdown and YAML, ensuring business logic is human-readable and machine-executable.</p>

        <div class="grid md:grid-cols-2 gap-6">
          <div class="space-y-3 font-mono text-xs">
            <div
              class="text-zinc-500 font-bold uppercase text-[10px] tracking-wider"
            >
              Key Engineering Specifications
            </div>
            <div class="flex justify-between items-center py-2 border-b border-white/5">
              <span class="text-zinc-400" x-text="nodes[selectedNode].specs[0].label">Parsing Engine</span>
              <span class="text-white font-bold" x-text="nodes[selectedNode].specs[0].val">Tree-sitter / YAML-rs</span>
            </div>
            <div class="flex justify-between items-center py-2 border-b border-white/5">
              <span class="text-zinc-400" x-text="nodes[selectedNode].specs[1].label">Validation</span>
              <span class="text-white font-bold" x-text="nodes[selectedNode].specs[1].val">Schema-Strict</span>
            </div>
            <div class="flex justify-between items-center py-2 border-b border-white/5">
              <span class="text-zinc-400" x-text="nodes[selectedNode].specs[2].label">Hot-Reload</span>
              <span class="text-white font-bold" x-text="nodes[selectedNode].specs[2].val">Instant (FS-Watch)</span>
            </div>
            <div class="flex justify-between items-center py-2 border-b border-white/5">
              <span class="text-zinc-400" x-text="nodes[selectedNode].specs[3].label">Control Mapping</span>
              <span class="text-white font-bold" x-text="nodes[selectedNode].specs[3].val">Deployment-Dependent</span>
            </div>
          </div>

          <div class="space-y-2">
            <div
              class="text-zinc-500 font-mono text-[10px] font-bold uppercase tracking-wider"
            >
              Architecture Code Contract
            </div>
            <pre
              class="p-4 rounded-xl bg-black border border-white/10 font-mono text-xs text-emerald-300 overflow-x-auto leading-relaxed"
              x-text="nodes[selectedNode].code">struct Directive &lbrace;
  id: Uuid,
  sop_version: String,
  parameters: HashMap&lt;String, Value&gt;,
  constraints: Vec&lt;Constraint&gt;,
&rbrace;</pre>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 2: AUDIENCE PERSPECTIVES (IT, MANAGER, EXECUTIVE, OPERATOR) -->
    <section class="space-y-12">
      <div class="text-center space-y-4 max-w-2xl mx-auto">
        <h2 class="text-4xl sm:text-5xl font-extrabold text-white font-outfit">
          Operational Perspectives
        </h2>
        <p class="text-zinc-400 font-light leading-relaxed">
          Select a role to see how AI-Tadpole-OS transforms security,
          governance, operational control, and daily execution.
        </p>
      </div>

      <!-- Tab Buttons -->
      <div
        class="flex flex-wrap justify-center gap-3 font-mono text-xs"
        role="tablist"
        aria-label="Operational perspectives"
        @keydown.right.prevent="movePerspectiveFocus(1)"
        @keydown.left.prevent="movePerspectiveFocus(-1)"
        @keydown.home.prevent="focusPerspectiveBoundary('first')"
        @keydown.end.prevent="focusPerspectiveBoundary('last')"
      >
        <button
          type="button"
          id="persp-tab-it"
          @click="selectPerspective('it')"
          role="tab"
          aria-controls="persp-panel-it"
          :aria-selected="activePerspective === 'it'"
          :tabindex="activePerspective === 'it' ? 0 : -1"
          :class="getPerspectiveClass('it')"
          class="px-6 py-3 rounded-xl border uppercase tracking-wider transition-all cursor-pointer"
        >
          🛡️ IT & Infrastructure
        </button>
        <button
          type="button"
          id="persp-tab-manager"
          @click="selectPerspective('manager')"
          role="tab"
          aria-controls="persp-panel-manager"
          :aria-selected="activePerspective === 'manager'"
          :tabindex="activePerspective === 'manager' ? 0 : -1"
          :class="getPerspectiveClass('manager')"
          class="px-6 py-3 rounded-xl border uppercase tracking-wider transition-all cursor-pointer"
        >
          📊 Operations Manager
        </button>
        <button
          type="button"
          id="persp-tab-exec"
          @click="selectPerspective('exec')"
          role="tab"
          aria-controls="persp-panel-exec"
          :aria-selected="activePerspective === 'exec'"
          :tabindex="activePerspective === 'exec' ? 0 : -1"
          :class="getPerspectiveClass('exec')"
          class="px-6 py-3 rounded-xl border uppercase tracking-wider transition-all cursor-pointer"
        >
          🏰 C-Suite Executive
        </button>
        <button
          type="button"
          id="persp-tab-operator"
          @click="selectPerspective('operator')"
          role="tab"
          aria-controls="persp-panel-operator"
          :aria-selected="activePerspective === 'operator'"
          :tabindex="activePerspective === 'operator' ? 0 : -1"
          :class="getPerspectiveClass('operator')"
          class="px-6 py-3 rounded-xl border uppercase tracking-wider transition-all cursor-pointer"
        >
          ⚡ Operator Employee
        </button>
      </div>

      <!-- Perspective Content Cards -->
      <div
        class="glass-surface p-8 sm:p-12 rounded-3xl border border-white/10 bg-black/40"
      >
        <!-- IT Perspective -->
        <div
          x-show="activePerspective === 'it'"
          id="persp-panel-it"
          role="tabpanel"
          aria-labelledby="persp-tab-it"
          tabindex="0"
          x-transition:enter="transition ease-out duration-300"
          x-transition:enter-start="opacity-0 translate-y-2"
          x-transition:enter-end="opacity-100 translate-y-0"
          class="grid md:grid-cols-2 gap-12 items-center"
        >
          <div class="space-y-6">
            <span
              class="px-3 py-1 rounded bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 font-mono text-xs font-bold uppercase"
            >
              Zero-Trust IT Security
            </span>
            <h3 class="text-3xl font-bold text-white font-outfit">
              Air-Gapped Local Security & Merkle Audits
            </h3>
            <p class="text-zinc-300 font-light leading-relaxed">
              IT departments define execution boundaries. When configured for
              air-gapped operation, the <strong>Hard Privacy Gate</strong> can
              disable external network access while tool activity is recorded
              for audit review.
            </p>
            <div class="space-y-3 font-mono text-xs">
              <div
                class="p-3 rounded-xl bg-zinc-950 border border-white/5 flex items-center justify-between"
              >
                <span class="text-zinc-400">Zero Cloud Data Exfiltration</span>
                <span class="text-emerald-400 font-bold"
                  >Air-Gapped Mode</span
                >
              </div>
              <div
                class="p-3 rounded-xl bg-zinc-950 border border-white/5 flex items-center justify-between"
              >
                <span class="text-zinc-400"
                  >Active Documentation Guard (ADG)</span
                >
                <span class="text-cyan-400 font-bold"
                  >Symbol Gate Enforcement</span
                >
              </div>
              <div
                class="p-3 rounded-xl bg-zinc-950 border border-white/5 flex items-center justify-between"
              >
                <span class="text-zinc-400">Audit Ledger Integrity</span>
                <span class="text-purple-400 font-bold"
                  >OBLITERATUS Cryptographic Trail</span
                >
              </div>
            </div>
          </div>

          <div
            class="relative rounded-2xl overflow-hidden border border-white/10 shadow-2xl group bg-black"
          >
            <img
              src={`${basePath}/assets/real_os_oversight.png`}
              alt="IT Security Controls"
              width="1662"
              height="905"
              loading="lazy"
              decoding="async"
              class="w-full h-auto object-cover"
            />
            <button
              type="button"
              @click={`openLightbox('${basePath}/assets/real_os_oversight.png', 'IT security controls')`}
              class="absolute bottom-3 right-3 bg-zinc-950/85 hover:bg-zinc-950 border border-white/20 text-white px-3 py-1.5 rounded-lg text-xs font-mono flex items-center gap-1.5 opacity-90 hover:opacity-100 transition-all backdrop-blur shadow-lg cursor-pointer"
            >
              <span>🔍 Zoom Full Resolution</span>
            </button>
          </div>
        </div>

        <!-- Manager Perspective -->
        <div
          x-show="activePerspective === 'manager'"
          id="persp-panel-manager"
          role="tabpanel"
          aria-labelledby="persp-tab-manager"
          tabindex="0"
          x-transition:enter="transition ease-out duration-300"
          x-transition:enter-start="opacity-0 translate-y-2"
          x-transition:enter-end="opacity-100 translate-y-0"
          class="grid md:grid-cols-2 gap-12 items-center"
        >
          <div class="space-y-6">
            <span
              class="px-3 py-1 rounded bg-purple-500/10 border border-purple-500/30 text-purple-400 font-mono text-xs font-bold uppercase"
            >
              Operational Governance
            </span>
            <h3 class="text-3xl font-bold text-white font-outfit">
              Continuous Telemetry & Human-In-The-Loop
            </h3>
            <p class="text-zinc-300 font-light leading-relaxed">
              Managers gain visibility over multi-agent workflows with
              <strong>10Hz MessagePack telemetry streams</strong> and WebSocket
              HITL gates. High-risk capabilities such as
              <code>shell:execute</code> and <code>budget:spend</code> require
              management approval.
            </p>
            <div class="space-y-3 font-mono text-xs">
              <div
                class="p-3 rounded-xl bg-zinc-950 border border-white/5 flex items-center justify-between"
              >
                <span class="text-zinc-400">Swarm Pulse Frequency</span>
                <span class="text-emerald-400 font-bold"
                  >10Hz Binary Stream</span
                >
              </div>
              <div
                class="p-3 rounded-xl bg-zinc-950 border border-white/5 flex items-center justify-between"
              >
                <span class="text-zinc-400">Sapphire Shield Intercept</span>
                <span class="text-amber-400 font-bold"
                  >WebSocket HITL Prompt</span
                >
              </div>
            </div>
          </div>

          <div
            class="relative rounded-2xl overflow-hidden border border-white/10 shadow-2xl group bg-black"
          >
            <img
              src={`${basePath}/assets/real_os_dashboard.png`}
              alt="Operations Dashboard"
              width="1662"
              height="905"
              loading="lazy"
              decoding="async"
              class="w-full h-auto object-cover"
            />
            <button
              type="button"
              @click={`openLightbox('${basePath}/assets/real_os_dashboard.png', 'Operations dashboard')`}
              class="absolute bottom-3 right-3 bg-zinc-950/85 hover:bg-zinc-950 border border-white/20 text-white px-3 py-1.5 rounded-lg text-xs font-mono flex items-center gap-1.5 opacity-90 hover:opacity-100 transition-all backdrop-blur shadow-lg cursor-pointer"
            >
              <span>🔍 Zoom Full Resolution</span>
            </button>
          </div>
        </div>

        <!-- Executive Perspective -->
        <div
          x-show="activePerspective === 'exec'"
          id="persp-panel-exec"
          role="tabpanel"
          aria-labelledby="persp-tab-exec"
          tabindex="0"
          x-transition:enter="transition ease-out duration-300"
          x-transition:enter-start="opacity-0 translate-y-2"
          x-transition:enter-end="opacity-100 translate-y-0"
          class="grid md:grid-cols-2 gap-12 items-center"
        >
          <div class="space-y-6">
            <span
              class="px-3 py-1 rounded bg-amber-500/10 border border-amber-500/30 text-amber-400 font-mono text-xs font-bold uppercase"
            >
              Enterprise Control
            </span>
            <h3 class="text-3xl font-bold text-white font-outfit">
              Sovereignty as the Ultimate Enterprise Advantage
            </h3>
            <p class="text-zinc-300 font-light leading-relaxed">
              Deploying Tadpole OS on organization-controlled hardware can
              reduce API dependency and keep proprietary context within the
              security boundaries selected for that deployment.
            </p>
            <div class="grid grid-cols-2 gap-4 font-mono text-xs">
              <div
                class="p-4 rounded-xl bg-zinc-950 border border-emerald-500/30 text-center space-y-1"
              >
                <div class="text-2xl text-emerald-400 font-bold">Local</div>
                <div class="text-zinc-400 text-[10px]">Configurable Data Boundary</div>
              </div>
              <div
                class="p-4 rounded-xl bg-zinc-950 border border-cyan-500/30 text-center space-y-1"
              >
                <div class="text-2xl text-cyan-400 font-bold">Optional</div>
                <div class="text-zinc-400 text-[10px]">
                  External Model Access
                </div>
              </div>
            </div>
          </div>

          <div
            class="relative rounded-2xl overflow-hidden border border-white/10 shadow-2xl group bg-black"
          >
            <img
              src={`${basePath}/assets/moat-visual.png`}
              alt="Sovereign Moat"
              width="640"
              height="640"
              loading="lazy"
              decoding="async"
              class="w-full h-auto object-cover"
            />
            <button
              type="button"
              @click={`openLightbox('${basePath}/assets/moat-visual.png', 'Sovereign moat')`}
              class="absolute bottom-3 right-3 bg-zinc-950/85 hover:bg-zinc-950 border border-white/20 text-white px-3 py-1.5 rounded-lg text-xs font-mono flex items-center gap-1.5 opacity-90 hover:opacity-100 transition-all backdrop-blur shadow-lg cursor-pointer"
            >
              <span>🔍 Zoom Full Resolution</span>
            </button>
          </div>
        </div>

        <!-- Operator Perspective -->
        <div
          x-show="activePerspective === 'operator'"
          id="persp-panel-operator"
          role="tabpanel"
          aria-labelledby="persp-tab-operator"
          tabindex="0"
          x-transition:enter="transition ease-out duration-300"
          x-transition:enter-start="opacity-0 translate-y-2"
          x-transition:enter-end="opacity-100 translate-y-0"
          class="grid md:grid-cols-2 gap-12 items-center"
        >
          <div class="space-y-6">
            <span
              class="px-3 py-1 rounded bg-cyan-500/10 border border-cyan-500/30 text-cyan-400 font-mono text-xs font-bold uppercase"
            >
              Supercharged Workforce
            </span>
            <h3 class="text-3xl font-bold text-white font-outfit">
              Transition from Manual Drudgery to Swarm Director
            </h3>
            <p class="text-zinc-300 font-light leading-relaxed">
              Operators turn routine SOPs into executable Markdown directives
              in <code>directives/</code>, supporting scaled work while
              maintaining human oversight over execution outcomes.
            </p>
            <div
              class="p-4 rounded-xl bg-zinc-950 border border-white/5 font-mono text-xs space-y-2 text-zinc-300"
            >
              <div class="text-emerald-400 font-bold">
                One Operator, Multiple Governed Workflows
