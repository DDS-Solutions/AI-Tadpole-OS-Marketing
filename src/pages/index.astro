---
import BaseLayout from "../layouts/BaseLayout.astro";
const basePath = '/AI-Tadpole-OS-Marketing';

const architectureLayers = [
  {
    label: "L1",
    title: "Directive Layer",
    detail:
      "Human-authored SOPs in Markdown. Versioned directives serve as the absolute source of truth for agent behavior.",
  },
  {
    label: "L2",
    title: "Orchestration Layer",
    detail:
      "Agent 99 coordinates swarm hierarchy, decomposes objectives, and performs Self-Annealing to refine long-term memory.",
  },
  {
    label: "L3",
    title: "Execution Layer",
    detail:
      "Rust-native engine and deterministic scripts execute tools in parallel using FuturesUnordered for absolute speed and security.",
  },
];

const interfaceSurfaces = [
  "Operations dashboard with 10Hz Swarm Pulse (MessagePack telemetry) and detachable portals",
  "Model manager with triple-slot routing (Primary, Secondary, Tertiary fallback slots)",
  "Codebase Knowledge Graph HUD with dynamic traversal history and BFS Dependency Pathfinder",
  "Security dashboard featuring the Sapphire Shield and OBLITERATUS Merkle audit trails",
];

const screenshots = [
  {
    src: `${basePath}/assets/real_os_dashboard.png`,
    title: "Operations Dashboard",
    desc: "10Hz Swarm Pulse MessagePack telemetry stream with detachable portals."
  },
  {
    src: `${basePath}/assets/real_os_nodes.png`,
    title: "Node Hierarchy & Swarms",
    desc: "Visual agent hierarchy traversal & active worker thread management."
  },
  {
    src: `${basePath}/assets/real_os_oversight.png`,
    title: "Sapphire Shield Governance",
    desc: "Zero-trust HITL gate & cryptographic Merkle proof decision history."
  },
  {
    src: `${basePath}/assets/real_os_templates.png`,
    title: "Swarm Architect & Templates",
    desc: "46+ pre-built declarative swarm templates for instant deployment."
  }
];
---

<style>
  [x-cloak] { display: none !important; }
  .font-mono-code {
    font-family: "JetBrains Mono", monospace;
  }
  .scanline-bg {
    background: linear-gradient(
      to bottom,
      rgba(255,255,255,0),
      rgba(255,255,255,0) 50%,
      rgba(16, 185, 129, 0.02) 50%,
      rgba(16, 185, 129, 0.02)
    );
    background-size: 100% 4px;
  }
  .slow-pulse-text {
    color: #ffffff;
    animation: slowPulse 4s ease-in-out infinite;
  }
  @keyframes slowPulse {
    0%, 100% {
      color: #ffffff;
      text-shadow: 0 0 10px rgba(52, 211, 153, 0);
    }
    50% {
      color: #a7f3d0;
      text-shadow: 0 0 25px rgba(52, 211, 153, 0.6);
    }
  }
</style>

<BaseLayout
  title="AI-Tadpole-OS | Local-First Multi-Agent Swarm Runtime"
  description="AI-Tadpole-OS is a local-first Rust and React runtime for sovereign multi-agent orchestration, live telemetry, model routing, and human-governed execution."
>
  <main id="main" class="relative z-10 space-y-24 pb-24" x-data="homepage()">
    
    <!-- HERO SECTION -->
    <section class="relative min-h-[90vh] overflow-hidden border-b border-white/10 pt-28 scanline-bg flex flex-col justify-between">
      <img
        src={`${basePath}/assets/real_os_dashboard.png`}
        alt="AI-Tadpole-OS Real Dashboard"
        class="absolute inset-0 h-full w-full object-cover opacity-20 cursor-pointer"
        loading="eager"
        @click={`openLightbox('${basePath}/assets/real_os_dashboard.png')`}
      />
      <div class="absolute inset-0 bg-[linear-gradient(90deg,#09090b_0%,rgba(9,9,11,0.92)_42%,rgba(9,9,11,0.62)_100%)] pointer-events-none"></div>
      <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-zinc-950 to-transparent pointer-events-none"></div>

      <div class="relative mx-auto flex min-h-[calc(88vh-7rem)] max-w-7xl flex-col justify-center px-5 py-16 sm:px-8">
        <div class="max-w-4xl space-y-8">
          <div class="inline-flex items-center gap-3 rounded-full border border-emerald-400/20 bg-zinc-950/80 px-4 py-1.5 font-mono text-xs font-bold uppercase tracking-widest text-emerald-300 backdrop-blur shadow-[0_0_20px_rgba(16,185,129,0.15)]">
            <span class="h-2 w-2 rounded-full bg-emerald-400 animate-ping"></span>
            Local-First Sovereign Protocol Runtime
          </div>

          <div class="space-y-5">
            <h1 class="text-6xl font-extrabold leading-[0.92] text-white sm:text-7xl lg:text-8xl font-outfit tracking-tight">
              AI-Tadpole-OS
            </h1>
            <p class="max-w-3xl text-xl leading-8 text-zinc-300 sm:text-2xl sm:leading-9 font-light">
              A sovereign command layer for multi-agent work: **Rust execution**, 
              **React observability**, **private LanceDB memory**, and **human-governed automation** in one local runtime.
            </p>
          </div>

          <div class="flex flex-wrap gap-4 pt-2 font-mono text-xs font-bold">
            <a
              href="https://github.com/DDS-Solutions/AI-TadPole-OS"
              class="px-8 py-4 bg-white text-zinc-950 rounded-xl hover:bg-zinc-200 transition-all duration-300 hover:scale-105 shadow-[0_0_25px_rgba(255,255,255,0.2)] uppercase tracking-wider"
            >
              Explore Source Repo
            </a>
            <a
              href={`${basePath}/mission`}
              class="px-8 py-4 bg-gradient-to-r from-emerald-500 to-teal-400 text-zinc-950 rounded-xl hover:from-emerald-400 hover:to-teal-300 transition-all duration-300 hover:scale-105 shadow-[0_0_25px_rgba(16,185,129,0.25)] uppercase tracking-wider"
            >
              ▶ Launch Mission Demo
            </a>
            <a
              href={`${basePath}/how-it-works`}
              class="px-8 py-4 border border-white/15 bg-white/5 text-zinc-100 rounded-xl hover:border-emerald-400 hover:text-emerald-300 transition-all duration-300 uppercase tracking-wider"
            >
              Architecture Specs ➔
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION: 3-LAYER ARCHITECTURE MODEL -->
    <section id="runtime" class="mx-auto max-w-7xl px-5 sm:px-8 space-y-12">
      <div class="grid lg:grid-cols-[0.9fr_1.1fr] gap-12 items-center">
        <div class="space-y-5">
          <span class="font-mono text-xs font-bold uppercase tracking-[0.24em] text-emerald-400">
            Runtime Architecture
          </span>
          <h2 class="text-4xl font-bold leading-tight text-white sm:text-5xl font-outfit">
            Built to keep strategy close to the machine.
          </h2>
          <p class="text-lg leading-8 text-zinc-400 font-light">
            AI-Tadpole-OS treats a clone as the unit of sovereignty. Directives, 
            orchestration, and execution remain inspectable so teams can run missions 
            without surrendering operational context to cloud intermediaries.
          </p>
        </div>

        <div class="grid gap-4">
          {
            architectureLayers.map((layer) => (
              <article class="grid gap-5 rounded-2xl border border-white/10 bg-zinc-950/60 p-6 sm:grid-cols-[5rem_1fr] hover:border-emerald-500/30 transition-all">
                <div class="font-mono text-3xl font-bold text-emerald-400 flex items-center justify-center rounded-xl bg-emerald-500/10 border border-emerald-500/20 h-16">
                  {layer.label}
                </div>
                <div class="space-y-2">
                  <h3 class="text-2xl font-bold text-white font-outfit">{layer.title}</h3>
                  <p class="leading-relaxed text-zinc-400 text-sm font-light">{layer.detail}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- SECTION: DENSE OPERATOR INTERFACE SCREENSHOT GALLERY -->
    <section id="interface" class="border-y border-white/10 bg-zinc-950/80 py-20">
      <div class="mx-auto max-w-7xl px-5 sm:px-8 space-y-12">
        <div class="text-center space-y-4 max-w-3xl mx-auto">
          <span class="font-mono text-xs font-bold uppercase tracking-widest text-emerald-400">
            Real Desktop Interface
          </span>
          <h2 class="text-4xl font-bold leading-tight text-white sm:text-5xl font-outfit">
            Dense Control Surfaces for Live Swarm Work
          </h2>
          <p class="text-lg leading-8 text-zinc-400 font-light">
            Captured live from the React + Tauri desktop engine. Operators inspect agents, 
            model routing slots, 10Hz MessagePack telemetry, and Merkle audit histories.
          </p>
        </div>

        <!-- 4 Real Screenshots Grid -->
        <div class="grid sm:grid-cols-2 gap-6">
          {
            screenshots.map((shot) => (
              <div class="glass-surface rounded-2xl border border-white/10 overflow-hidden shadow-2xl p-4 space-y-3 group hover:border-emerald-500/40 transition-all">
                <div class="relative rounded-xl overflow-hidden bg-black border border-white/10">
                  <img
                    src={shot.src}
                    alt={shot.title}
                    class="w-full h-auto object-cover group-hover:scale-[1.02] transition-transform duration-500 cursor-pointer"
                    @click={`openLightbox('${shot.src}')`}
                  />
                  <button
                    @click={`openLightbox('${shot.src}')`}
                    class="absolute bottom-3 right-3 bg-zinc-950/85 hover:bg-zinc-950 border border-white/20 text-white px-3 py-1.5 rounded-lg text-xs font-mono flex items-center gap-1.5 opacity-90 hover:opacity-100 transition-all backdrop-blur shadow-lg cursor-pointer"
                  >
                    <span>🔍 Zoom Full Resolution</span>
                  </button>
                </div>
                <div>
                  <h3 class="font-bold text-white text-lg font-outfit">{shot.title}</h3>
                  <p class="text-xs text-zinc-400 font-light mt-1">{shot.desc}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- SECTION: DECLARATIVE SWARM TEMPLATES -->
    <section id="templates" class="mx-auto max-w-7xl px-5 sm:px-8 space-y-12">
      <div class="text-center space-y-4 max-w-3xl mx-auto">
        <span class="font-mono text-xs font-bold uppercase tracking-widest text-emerald-400">
          Declarative Swarm Library
        </span>
        <h2 class="text-4xl font-bold leading-tight text-white sm:text-5xl font-outfit">
          46+ Pre-Built Production Swarm Templates
        </h2>
        <p class="text-lg leading-8 text-zinc-400 font-light">
          Instantly initialize autonomous multi-agent teams configured with predefined directives, MCP tool bindings, and zero-trust security profiles.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-6 font-mono text-xs">
        <!-- Template Card 1 -->
        <div class="glass-surface p-6 rounded-2xl border border-emerald-500/30 space-y-4 hover:border-emerald-500 transition-all">
          <div class="flex items-center justify-between">
            <span class="text-emerald-400 font-bold uppercase text-[10px]">Security & Audit</span>
            <span class="px-2 py-0.5 rounded bg-emerald-500/10 border border-emerald-500/20 text-emerald-300 text-[10px]">3 Subagents</span>
          </div>
          <h3 class="text-xl font-bold text-white font-outfit">Codebase FFI Vulnerability Sentinel</h3>
          <p class="text-zinc-400 text-xs font-light leading-relaxed">
            Scans Rust/C FFI boundaries, checks memory safety invariants, and logs cryptographic Merkle proof receipts.
          </p>
          <div class="p-3 rounded bg-zinc-950 border border-white/5 text-[11px] text-zinc-400">
            Tools: <span class="text-white">grep_search, adg01_symbol_gate, merkele_audit</span>
          </div>
        </div>

        <!-- Template Card 2 -->
        <div class="glass-surface p-6 rounded-2xl border border-cyan-500/30 space-y-4 hover:border-cyan-500 transition-all">
          <div class="flex items-center justify-between">
            <span class="text-cyan-400 font-bold uppercase text-[10px]">Architecture & Refactor</span>
            <span class="px-2 py-0.5 rounded bg-cyan-500/10 border border-cyan-500/20 text-cyan-300 text-[10px]">4 Subagents</span>
          </div>
          <h3 class="text-xl font-bold text-white font-outfit">GraphRAG Knowledge Indexer</h3>
          <p class="text-zinc-400 text-xs font-light leading-relaxed">
            Parses multi-file AST graphs, computes 768-dim LanceDB embeddings, and updates Institutional Knowledge Store (IKS).
          </p>
          <div class="p-3 rounded bg-zinc-950 border border-white/5 text-[11px] text-zinc-400">
            Tools: <span class="text-white">lancedb_vector, ast_parser, graph_rag_query</span>
          </div>
        </div>

        <!-- Template Card 3 -->
        <div class="glass-surface p-6 rounded-2xl border border-purple-500/30 space-y-4 hover:border-purple-500 transition-all">
          <div class="flex items-center justify-between">
            <span class="text-purple-400 font-bold uppercase text-[10px]">Executive & EBITDA</span>
            <span class="px-2 py-0.5 rounded bg-purple-500/10 border border-purple-500/20 text-purple-300 text-[10px]">5 Subagents</span>
          </div>
          <h3 class="text-xl font-bold text-white font-outfit">Self-Annealing Operations Synthesizer</h3>
          <p class="text-zinc-400 text-xs font-light leading-relaxed">
            Decomposes high-level strategic directives, monitors 10Hz telemetry streams, and executes self-correction loops.
          </p>
          <div class="p-3 rounded bg-zinc-950 border border-white/5 text-[11px] text-zinc-400">
            Tools: <span class="text-white">agent_99_router, sapphire_shield, telemetry_pulse</span>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION: ROADMAP -->
    <section id="roadmap" class="border-t border-white/10 bg-zinc-950/90 py-20">
      <div class="mx-auto max-w-7xl px-5 sm:px-8 space-y-12">
        <div class="text-center space-y-4 max-w-3xl mx-auto">
          <span class="font-mono text-xs font-bold uppercase tracking-widest text-cyan-400">
            Protocol Trajectory
          </span>
          <h2 class="text-4xl font-bold leading-tight text-white sm:text-5xl font-outfit">
            Sovereignty Roadmap
          </h2>
          <p class="text-lg leading-8 text-zinc-400 font-light">
            The engineering release pipeline for Tadpole OS local multi-agent swarm orchestration.
          </p>
        </div>

        <div class="grid md:grid-cols-4 gap-6 font-mono text-xs">
          <!-- Q1 -->
          <div class="p-6 rounded-2xl bg-zinc-950 border border-emerald-500/30 space-y-3">
            <div class="flex items-center justify-between text-emerald-400 font-bold">
              <span>Q1 2026</span>
              <span class="px-2 py-0.5 bg-emerald-500/10 border border-emerald-500/20 text-[10px] rounded">COMPLETED</span>
            </div>
            <h3 class="text-lg font-bold text-white font-outfit">Rust Core Engine v1.1</h3>
            <p class="text-zinc-400 text-xs font-light leading-relaxed">
              Axum/Tokio async execution, 10Hz MessagePack WebSocket stream, and Sapphire Shield zero-trust HITL gate.
            </p>
          </div>

          <!-- Q2 -->
          <div class="p-6 rounded-2xl bg-zinc-950 border border-cyan-500/30 space-y-3">
            <div class="flex items-center justify-between text-cyan-400 font-bold">
              <span>Q2 2026</span>
              <span class="px-2 py-0.5 bg-cyan-500/10 border border-cyan-500/20 text-[10px] rounded">ACTIVE RELEASE</span>
            </div>
            <h3 class="text-lg font-bold text-white font-outfit">Tauri Desktop & GraphRAG</h3>
            <p class="text-zinc-400 text-xs font-light leading-relaxed">
              React + Tauri desktop engine, LanceDB 768-dim vector embeddings, and real-time trace waterfall viewer.
            </p>
          </div>

          <!-- Q3 -->
          <div class="p-6 rounded-2xl bg-zinc-950 border border-purple-500/30 space-y-3">
            <div class="flex items-center justify-between text-purple-400 font-bold">
              <span>Q3 2026</span>
              <span class="px-2 py-0.5 bg-purple-500/10 border border-purple-500/20 text-[10px] rounded">UPCOMING</span>
            </div>
            <h3 class="text-lg font-bold text-white font-outfit">Multi-Node Mesh Swarms</h3>
            <p class="text-zinc-400 text-xs font-light leading-relaxed">
              Distributed local mesh networking across multi-GPU hardware nodes with PWA offline whitepaper vault.
            </p>
          </div>

          <!-- Q4 -->
          <div class="p-6 rounded-2xl bg-zinc-950 border border-amber-500/30 space-y-3">
            <div class="flex items-center justify-between text-amber-400 font-bold">
              <span>Q4 2026</span>
              <span class="px-2 py-0.5 bg-amber-500/10 border border-amber-500/20 text-[10px] rounded">PLANNED</span>
            </div>
            <h3 class="text-lg font-bold text-white font-outfit">Autonomous Enterprise Cluster</h3>
            <p class="text-zinc-400 text-xs font-light leading-relaxed">
              ISO 9001 / ALCOA+ automated compliance ledger, OBLITERATUS Merkle proofs, and enterprise cluster manager.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION: BOTTOM CTA SLOW PULSE -->
    <section class="max-w-5xl mx-auto px-5 text-center space-y-8 py-12">
      <div class="glass-surface p-12 rounded-3xl border border-emerald-500/20 bg-gradient-to-b from-emerald-500/5 to-transparent space-y-6">
        <p class="text-xs font-mono uppercase tracking-[0.3em] text-emerald-400 font-bold">
          Clone the Local Runtime
        </p>
        <h2 class="text-4xl font-bold leading-tight sm:text-6xl slow-pulse-text font-outfit">
          Own the directives, memory, and execution path.
        </h2>
        <p class="text-base sm:text-lg text-zinc-400 max-w-2xl mx-auto font-light leading-relaxed">
          AI-Tadpole-OS empowers your team to run parallel agent swarms locally on your own hardware with 100% data privacy.
        </p>
        <div class="flex flex-wrap justify-center gap-4 pt-4 font-mono text-xs font-bold">
          <a
            href="https://github.com/DDS-Solutions/AI-TadPole-OS"
            class="px-10 py-4 bg-white text-zinc-950 rounded-xl hover:bg-zinc-200 transition-all uppercase tracking-wider shadow-lg"
          >
            Get Started on GitHub
          </a>
          <a
            href={`${basePath}/mission`}
            class="px-10 py-4 border border-white/20 bg-white/5 text-white rounded-xl hover:border-emerald-400 hover:text-emerald-300 transition-all uppercase tracking-wider"
          >
            Run Mission Simulator ➔
          </a>
        </div>
      </div>
    </section>

    <!-- LIGHTBOX MODAL FOR FULL RESOLUTION SCREENSHOTS -->
    <div
      x-show="lightboxOpen"
      x-cloak
      x-transition:enter="transition ease-out duration-300"
      x-transition:enter-start="opacity-0 scale-95"
      x-transition:enter-end="opacity-100 scale-100"
      x-transition:leave="transition ease-in duration-200"
      x-transition:leave-start="opacity-100 scale-100"
      x-transition:leave-end="opacity-0 scale-95"
      class="fixed inset-0 z-[100] bg-black/95 backdrop-blur-2xl flex flex-col items-center justify-center p-4 sm:p-6"
      @click="lightboxOpen = false"
      @keydown.escape.window="lightboxOpen = false"
    >
      <!-- Top Floating Controls Header -->
      <div class="w-full max-w-6xl flex items-center justify-between pb-4 font-mono text-xs z-10" @click.stop>
        <div class="flex items-center gap-2 text-zinc-400">
          <span class="text-emerald-400 font-bold">🔍 High-Resolution Preview</span>
          <span class="text-zinc-600">|</span>
          <span class="text-zinc-500">Press ESC or click anywhere to exit</span>
        </div>

        <button
          @click="lightboxOpen = false"
          class="px-4 py-2 bg-emerald-500 hover:bg-emerald-400 text-zinc-950 font-bold rounded-xl border border-emerald-400 shadow-xl transition-all hover:scale-105 active:scale-95 cursor-pointer flex items-center gap-2"
        >
          <span>✕</span> Close Full Screen
        </button>
      </div>

      <!-- Image Container -->
      <div class="relative max-w-6xl max-h-[82vh] flex items-center justify-center overflow-hidden rounded-2xl border border-white/20 shadow-2xl bg-zinc-950" @click.stop>
        <img
          :src="lightboxImg"
          class="max-h-[82vh] max-w-full w-auto h-auto object-contain rounded-2xl select-none"
          alt="Full Resolution Screenshot"
        />
      </div>
    </div>

  </main>

  <script is:inline>
    function homepage() {
      return {
        lightboxOpen: false,
        lightboxImg: '',
        openLightbox(imgUrl) {
          this.lightboxImg = imgUrl;
          this.lightboxOpen = true;
        }
      };
    }
  </script>

  <script is:inline src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
</BaseLayout>
