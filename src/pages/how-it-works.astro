---
import BaseLayout from "../layouts/BaseLayout.astro";
const basePath = '/AI-Tadpole-OS-Marketing';
---

<style>
  .font-mono-code {
    font-family: "JetBrains Mono", monospace;
  }

  .neural-pulse-line {
    stroke-dasharray: 20;
    animation: dashPulse 2s linear infinite;
  }
  @keyframes dashPulse {
    to { stroke-dashoffset: -40; }
  }

  .scanline-bg {
    background: linear-gradient(
      to bottom,
      rgba(255,255,255,0),
      rgba(255,255,255,0) 50%,
      rgba(16, 185, 129, 0.02) 50%,
      rgba(16, 185, 129, 0.02)
    );
    background-size: 100% 4px;
  }

  .glow-box-emerald {
    box-shadow: 0 0 30px rgba(16, 185, 129, 0.15);
  }
</style>

<BaseLayout
  title="Engine Mechanics & Architecture | AI-Tadpole-OS Sovereign Protocol"
  description="Deep-dive into the AI-Tadpole-OS technical architecture: 3-layer orchestration stack, Rust Axum/Tokio execution engine, Sapphire Shield zero-trust HITL gate, and LanceDB GraphRAG memory."
>
  <main
    class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 py-20 md:py-28 space-y-24"
    x-data="howItWorksPage()"
  >
    <!-- Header -->
    <header class="text-center space-y-6 max-w-4xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-emerald-500/20 bg-emerald-500/10 text-emerald-400 font-mono text-xs uppercase tracking-widest backdrop-blur">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
        Technical Architecture & Mechanics
      </div>
      <h1 class="text-5xl sm:text-7xl lg:text-8xl font-extrabold tracking-tight text-white font-outfit leading-[0.95]">
        High-Fidelity <span class="bg-gradient-to-r from-emerald-400 via-teal-300 to-cyan-400 bg-clip-text text-transparent">Architecture</span>
      </h1>
      <p class="text-base sm:text-lg text-zinc-400 font-light leading-relaxed max-w-2xl mx-auto">
        A comprehensive technical deep-dive into the sovereign engine: **3-Layer Separation of Concerns**, 
        **Axum/Tokio Async Execution**, **Sapphire Shield Governance**, and **LanceDB GraphRAG Memory**.
      </p>
    </header>

    <!-- INTERACTIVE ARCHITECTURE EXPLORER HUD -->
    <section class="glass-surface rounded-3xl border border-white/10 overflow-hidden shadow-2xl p-6 sm:p-10 space-y-8 scanline-bg glow-box-emerald">
      <div class="flex flex-wrap items-center justify-between gap-4 border-b border-white/10 pb-6">
        <div>
          <div class="flex items-center gap-3">
            <span class="text-2xl">⚙️</span>
            <h2 class="text-2xl font-bold text-white font-outfit">Sovereign Protocol Core Stack</h2>
          </div>
          <p class="text-xs text-zinc-400 mt-1 font-mono">
            Click any component below to inspect runtime specs, data flows, and code contracts.
          </p>
        </div>

        <div class="flex items-center gap-2 font-mono text-xs text-emerald-400 bg-emerald-500/10 px-3 py-1.5 rounded-xl border border-emerald-500/20">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
          <span>Version 1.1.307 Active</span>
        </div>
      </div>

      <!-- Interactive 5-Component Architecture Pipeline -->
      <div class="grid grid-cols-1 md:grid-cols-5 gap-3 font-mono text-xs">
        <button
          @click="selectNode('directive')"
          :class="getNodeClass('directive')"
          class="p-4 rounded-2xl border text-left transition-all duration-200 space-y-2 relative overflow-hidden group cursor-pointer"
        >
          <div class="text-[10px] text-emerald-400 font-bold uppercase tracking-widest">Layer 1</div>
          <div class="text-sm font-bold text-white font-outfit">Directives SOP</div>
          <div class="text-[11px] text-zinc-400 font-light">Markdown SOPs & YAML Parameters</div>
        </button>

        <button
          @click="selectNode('orchestration')"
          :class="getNodeClass('orchestration')"
          class="p-4 rounded-2xl border text-left transition-all duration-200 space-y-2 relative overflow-hidden group cursor-pointer"
        >
          <div class="text-[10px] text-purple-400 font-bold uppercase tracking-widest">Layer 2</div>
          <div class="text-sm font-bold text-white font-outfit">Agent 99 Router</div>
          <div class="text-[11px] text-zinc-400 font-light">Tri-Slot Fallback & Swarm Hierarchy</div>
        </button>

        <button
          @click="selectNode('execution')"
          :class="getNodeClass('execution')"
          class="p-4 rounded-2xl border text-left transition-all duration-200 space-y-2 relative overflow-hidden group cursor-pointer"
        >
          <div class="text-[10px] text-cyan-400 font-bold uppercase tracking-widest">Layer 3</div>
          <div class="text-sm font-bold text-white font-outfit">Rust Core Engine</div>
          <div class="text-[11px] text-zinc-400 font-light">Axum/Tokio & FuturesUnordered</div>
        </button>

        <button
          @click="selectNode('governance')"
          :class="getNodeClass('governance')"
          class="p-4 rounded-2xl border text-left transition-all duration-200 space-y-2 relative overflow-hidden group cursor-pointer"
        >
          <div class="text-[10px] text-amber-400 font-bold uppercase tracking-widest">Governance</div>
          <div class="text-sm font-bold text-white font-outfit">Sapphire Shield</div>
          <div class="text-[11px] text-zinc-400 font-light">Zero-Trust HITL & Merkle Proofs</div>
        </button>

        <button
          @click="selectNode('memory')"
          :class="getNodeClass('memory')"
          class="p-4 rounded-2xl border text-left transition-all duration-200 space-y-2 relative overflow-hidden group cursor-pointer"
        >
          <div class="text-[10px] text-blue-400 font-bold uppercase tracking-widest">Memory Store</div>
          <div class="text-sm font-bold text-white font-outfit">LanceDB GraphRAG</div>
          <div class="text-[11px] text-zinc-400 font-light">IKS Vectors & 768-dim Embeddings</div>
        </button>
      </div>

      <!-- Node Technical Spec Detail Card -->
      <div class="p-6 sm:p-8 rounded-2xl bg-zinc-950/90 border border-white/10 space-y-6">
        <div class="flex flex-wrap items-center justify-between gap-4 border-b border-white/10 pb-4">
          <div class="flex items-center gap-3">
            <span class="text-3xl" x-text="nodes[selectedNode].icon"></span>
            <div>
              <h3 class="text-2xl font-bold text-white font-outfit" x-text="nodes[selectedNode].title"></h3>
              <p class="text-xs font-mono text-emerald-400" x-text="nodes[selectedNode].subTitle"></p>
            </div>
          </div>

          <span class="px-3 py-1 rounded-full bg-white/5 border border-white/10 font-mono text-xs text-zinc-300 font-bold" x-text="nodes[selectedNode].badge"></span>
        </div>

        <p class="text-base text-zinc-300 font-light leading-relaxed" x-text="nodes[selectedNode].description"></p>

        <div class="grid md:grid-cols-2 gap-6">
          <div class="space-y-3 font-mono text-xs">
            <div class="text-zinc-500 font-bold uppercase text-[10px] tracking-wider">Key Engineering Specifications</div>
            <template x-for="(spec, sIdx) in nodes[selectedNode].specs" :key="sIdx">
              <div class="flex justify-between items-center py-2 border-b border-white/5">
                <span class="text-zinc-400" x-text="spec.label"></span>
                <span class="text-white font-bold" x-text="spec.val"></span>
              </div>
            </template>
          </div>

          <div class="space-y-2">
            <div class="text-zinc-500 font-mono text-[10px] font-bold uppercase tracking-wider">Architecture Code Contract</div>
            <pre class="p-4 rounded-xl bg-black border border-white/10 font-mono text-xs text-emerald-300 overflow-x-auto leading-relaxed" x-text="nodes[selectedNode].code"></pre>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 2: AUDIENCE PERSPECTIVES (IT, MANAGER, EXECUTIVE, OPERATOR) -->
    <section class="space-y-12">
      <div class="text-center space-y-4 max-w-2xl mx-auto">
        <h2 class="text-4xl sm:text-5xl font-extrabold text-white font-outfit">
          Operational Perspectives
        </h2>
        <p class="text-zinc-400 font-light leading-relaxed">
          Select a role to see how AI-Tadpole-OS transforms security, governance, EBITDA protection, and daily execution.
        </p>
      </div>

      <!-- Tab Buttons -->
      <div class="flex flex-wrap justify-center gap-3 font-mono text-xs">
        <button
          @click="selectPerspective('it')"
          :class="getPerspectiveClass('it')"
          class="px-6 py-3 rounded-xl border uppercase tracking-wider transition-all cursor-pointer"
        >
          🛡️ IT & Infrastructure
        </button>
        <button
          @click="selectPerspective('manager')"
          :class="getPerspectiveClass('manager')"
          class="px-6 py-3 rounded-xl border uppercase tracking-wider transition-all cursor-pointer"
        >
          📊 Operations Manager
        </button>
        <button
          @click="selectPerspective('exec')"
          :class="getPerspectiveClass('exec')"
          class="px-6 py-3 rounded-xl border uppercase tracking-wider transition-all cursor-pointer"
        >
          🏰 C-Suite Executive
        </button>
        <button
          @click="selectPerspective('operator')"
          :class="getPerspectiveClass('operator')"
          class="px-6 py-3 rounded-xl border uppercase tracking-wider transition-all cursor-pointer"
        >
          ⚡ Operator Employee
        </button>
      </div>

      <!-- Perspective Content Cards -->
      <div class="glass-surface p-8 sm:p-12 rounded-3xl border border-white/10 bg-black/40">
        <!-- IT Perspective -->
        <div x-show="activePerspective === 'it'" class="grid md:grid-cols-2 gap-12 items-center animate-fadeIn">
          <div class="space-y-6">
            <span class="px-3 py-1 rounded bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 font-mono text-xs font-bold uppercase">
              Zero-Trust IT Security
            </span>
            <h3 class="text-3xl font-bold text-white font-outfit">Air-Gapped Local Security & Merkle Audits</h3>
            <p class="text-zinc-300 font-light leading-relaxed">
              IT departments maintain 100% control over execution boundaries. All external network access can be disabled via the **Hard Privacy Gate**, while every single tool call generates an immutable Merkle-tree audit receipt logged in SQLite + LanceDB storage.
            </p>
            <div class="space-y-3 font-mono text-xs">
              <div class="p-3 rounded-xl bg-zinc-950 border border-white/5 flex items-center justify-between">
                <span class="text-zinc-400">Zero Cloud Data Exfiltration</span>
                <span class="text-emerald-400 font-bold">100% Air-Gapped Option</span>
              </div>
              <div class="p-3 rounded-xl bg-zinc-950 border border-white/5 flex items-center justify-between">
                <span class="text-zinc-400">Active Documentation Guard (ADG)</span>
                <span class="text-cyan-400 font-bold">Symbol Gate Enforcement</span>
              </div>
              <div class="p-3 rounded-xl bg-zinc-950 border border-white/5 flex items-center justify-between">
                <span class="text-zinc-400">Audit Ledger Integrity</span>
                <span class="text-purple-400 font-bold">OBLITERATUS Cryptographic Trail</span>
              </div>
            </div>
          </div>

          <div class="rounded-2xl overflow-hidden border border-white/10 shadow-2xl">
            <img src={`${basePath}/assets/real_os_oversight.png`} alt="IT Security Controls" class="w-full h-auto object-cover" />
          </div>
        </div>

        <!-- Manager Perspective -->
        <div x-show="activePerspective === 'manager'" class="grid md:grid-cols-2 gap-12 items-center animate-fadeIn">
          <div class="space-y-6">
            <span class="px-3 py-1 rounded bg-purple-500/10 border border-purple-500/30 text-purple-400 font-mono text-xs font-bold uppercase">
              Operational Governance
            </span>
            <h3 class="text-3xl font-bold text-white font-outfit">Continuous Telemetry & Human-In-The-Loop</h3>
            <p class="text-zinc-300 font-light leading-relaxed">
              Managers gain complete visibility over multi-agent workflows with **10Hz MessagePack telemetry streams** and WebSocket HITL gates. High-risk capabilities (`shell:execute`, `budget:spend`) are frozen until signed by management.
            </p>
            <div class="space-y-3 font-mono text-xs">
              <div class="p-3 rounded-xl bg-zinc-950 border border-white/5 flex items-center justify-between">
                <span class="text-zinc-400">Swarm Pulse Frequency</span>
                <span class="text-emerald-400 font-bold">10Hz Binary Stream</span>
              </div>
              <div class="p-3 rounded-xl bg-zinc-950 border border-white/5 flex items-center justify-between">
                <span class="text-zinc-400">Sapphire Shield Intercept</span>
                <span class="text-amber-400 font-bold">WebSocket HITL Prompt</span>
              </div>
            </div>
          </div>

          <div class="rounded-2xl overflow-hidden border border-white/10 shadow-2xl">
            <img src={`${basePath}/assets/real_os_dashboard.png`} alt="Operations Dashboard" class="w-full h-auto object-cover" />
          </div>
        </div>

        <!-- Executive Perspective -->
        <div x-show="activePerspective === 'exec'" class="grid md:grid-cols-2 gap-12 items-center animate-fadeIn">
          <div class="space-y-6">
            <span class="px-3 py-1 rounded bg-amber-500/10 border border-amber-500/30 text-amber-400 font-mono text-xs font-bold uppercase">
              Enterprise EBITDA Moat
            </span>
            <h3 class="text-3xl font-bold text-white font-outfit">Sovereignty as the Ultimate Enterprise Advantage</h3>
            <p class="text-zinc-300 font-light leading-relaxed">
              By deploying Tadpole OS locally on hardware nodes, enterprises eliminate API vendor lock-in, protect proprietary trade secrets, and expand EBITDA margins through autonomous swarm scaling.
            </p>
            <div class="grid grid-cols-2 gap-4 font-mono text-xs">
              <div class="p-4 rounded-xl bg-zinc-950 border border-emerald-500/30 text-center space-y-1">
                <div class="text-2xl text-emerald-400 font-bold">100%</div>
                <div class="text-zinc-400 text-[10px]">Data & IP Ownership</div>
              </div>
              <div class="p-4 rounded-xl bg-zinc-950 border border-cyan-500/30 text-center space-y-1">
                <div class="text-2xl text-cyan-400 font-bold">0 $</div>
                <div class="text-zinc-400 text-[10px]">Cloud API Exfiltration Risk</div>
              </div>
            </div>
          </div>

          <div class="rounded-2xl overflow-hidden border border-white/10 shadow-2xl">
            <img src={`${basePath}/assets/moat-visual.png`} alt="Sovereign Moat" class="w-full h-auto object-cover" />
          </div>
        </div>

        <!-- Operator Perspective -->
        <div x-show="activePerspective === 'operator'" class="grid md:grid-cols-2 gap-12 items-center animate-fadeIn">
          <div class="space-y-6">
            <span class="px-3 py-1 rounded bg-cyan-500/10 border border-cyan-500/30 text-cyan-400 font-mono text-xs font-bold uppercase">
              Supercharged Workforce
            </span>
            <h3 class="text-3xl font-bold text-white font-outfit">Transition from Manual Drudgery to Swarm Director</h3>
            <p class="text-zinc-300 font-light leading-relaxed">
              Operators turn routine SOPs into executable Markdown directives (`directives/`), multiplying individual output by 10x to 100x while maintaining full human oversight over execution outcomes.
            </p>
            <div class="p-4 rounded-xl bg-zinc-950 border border-white/5 font-mono text-xs space-y-2 text-zinc-300">
              <div class="text-emerald-400 font-bold">1 Employee + Tadpole Swarm = 50 Specialist Hours / Day</div>
              <p class="text-zinc-500 text-[11px] font-light">Ingest playbooks, run parallel audits, and synthesize executive findings automatically.</p>
            </div>
          </div>

          <div class="rounded-2xl overflow-hidden border border-white/10 shadow-2xl">
            <img src={`${basePath}/assets/real_os_nodes.png`} alt="Operator Node Management" class="w-full h-auto object-cover" />
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 3: TRI-SLOT MODEL ROUTER INTERACTIVE DEMO -->
    <section class="glass-surface rounded-3xl border border-white/10 p-8 sm:p-12 space-y-8 bg-gradient-to-b from-black/60 to-zinc-950">
      <div class="text-center space-y-3 max-w-3xl mx-auto">
        <span class="px-3 py-1 rounded bg-cyan-500/10 border border-cyan-500/30 text-cyan-400 font-mono text-xs font-bold uppercase">
          Dynamic Redundancy Engine
        </span>
        <h2 class="text-3xl sm:text-4xl font-bold text-white font-outfit">Tri-Slot Model Routing Architecture</h2>
        <p class="text-sm text-zinc-400 font-light leading-relaxed">
          AI-Tadpole-OS decouples model selection from application logic. The engine automatically routes prompts across three fallback slots to guarantee 100% mission uptime.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-6 font-mono text-xs">
        <!-- Primary Slot -->
        <div class="p-6 rounded-2xl bg-zinc-950 border border-emerald-500/40 space-y-4 shadow-[0_0_25px_rgba(16,185,129,0.1)]">
          <div class="flex items-center justify-between">
            <span class="text-emerald-400 font-bold uppercase text-[10px]">Slot 1: Primary</span>
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-ping"></span>
          </div>
          <h3 class="text-lg font-bold text-white font-outfit">Local Ollama Engine</h3>
          <p class="text-zinc-400 text-xs font-light leading-relaxed">
            Local qwen2.5-coder / llama3.3 models running air-gapped on hardware GPU/NPU acceleration.
          </p>
          <div class="p-3 rounded bg-black border border-white/5 text-[11px] text-emerald-300">
            Latency: ~12ms | Cost: $0.00
          </div>
        </div>

        <!-- Secondary Slot -->
        <div class="p-6 rounded-2xl bg-zinc-950 border border-cyan-500/40 space-y-4 shadow-[0_0_25px_rgba(6,182,212,0.1)]">
          <div class="flex items-center justify-between">
            <span class="text-cyan-400 font-bold uppercase text-[10px]">Slot 2: Secondary</span>
            <span class="w-2.5 h-2.5 rounded-full bg-cyan-400"></span>
          </div>
          <h3 class="text-lg font-bold text-white font-outfit">Groq Ultra-Speed LPU</h3>
          <p class="text-zinc-400 text-xs font-light leading-relaxed">
            Ultra-fast cloud inference fallback (500+ tokens/sec) for complex multi-agent reasoning tasks.
          </p>
          <div class="p-3 rounded bg-black border border-white/5 text-[11px] text-cyan-300">
            Latency: ~80ms | Fallback Ready
          </div>
        </div>

        <!-- Tertiary Slot -->
        <div class="p-6 rounded-2xl bg-zinc-950 border border-purple-500/40 space-y-4 shadow-[0_0_25px_rgba(168,85,247,0.1)]">
          <div class="flex items-center justify-between">
            <span class="text-purple-400 font-bold uppercase text-[10px]">Slot 3: Tertiary</span>
            <span class="w-2.5 h-2.5 rounded-full bg-purple-400"></span>
          </div>
          <h3 class="text-lg font-bold text-white font-outfit">Google Gemini 1.5 Flash</h3>
          <p class="text-zinc-400 text-xs font-light leading-relaxed">
            Massive 2M token context window slot for large document ingestion & deep architectural synthesis.
          </p>
          <div class="p-3 rounded bg-black border border-white/5 text-[11px] text-purple-300">
            Context: 2M Tokens | Sovereign Backup
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 4: PROTOCOL SPECIFICATIONS TABLE -->
    <section class="space-y-8">
      <div class="text-center space-y-3">
        <h2 class="text-3xl font-bold text-white font-outfit">Core Protocol Performance Metrics</h2>
        <p class="text-sm text-zinc-400 font-light">Verified metrics across Rust `server-rs` and Tauri desktop builds.</p>
      </div>

      <div class="glass-surface rounded-2xl border border-white/10 overflow-hidden font-mono text-xs">
        <div class="grid grid-cols-3 bg-zinc-950 p-4 border-b border-white/10 text-zinc-400 font-bold uppercase text-[10px]">
          <div>Component / Subsystem</div>
          <div>Target Specification</div>
          <div>Runtime Performance</div>
        </div>
        <div class="divide-y divide-white/5 bg-black/40 text-zinc-300">
          <div class="grid grid-cols-3 p-4 items-center">
            <div class="font-bold text-white">Swarm Pulse Telemetry</div>
            <div>MessagePack over WebSockets</div>
            <div class="text-emerald-400 font-bold">10Hz Stream (100ms interval)</div>
          </div>
          <div class="grid grid-cols-3 p-4 items-center">
            <div class="font-bold text-white">Vector Search (LanceDB)</div>
            <div>768-dim text-embedding-004</div>
            <div class="text-cyan-400 font-bold">&lt; 8ms Nearest Neighbor</div>
          </div>
          <div class="grid grid-cols-3 p-4 items-center">
            <div class="font-bold text-white">Active Doc Guard (ADG-01)</div>
            <div>Symbol Gate Static Analysis</div>
            <div class="text-purple-400 font-bold">100% Symbol Validation</div>
          </div>
          <div class="grid grid-cols-3 p-4 items-center">
            <div class="font-bold text-white">Governance Authorization</div>
            <div>Sapphire Shield HITL Gate</div>
            <div class="text-amber-400 font-bold">Zero-Trust Merkle Proof</div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-16 glass-surface rounded-3xl p-8 sm:p-12 text-center space-y-6 border border-emerald-500/20 bg-gradient-to-r from-emerald-500/5 to-cyan-500/5">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white font-outfit">Ready to Deploy Sovereign Swarms?</h2>
      <p class="text-zinc-400 max-w-xl mx-auto font-light text-sm">
        Clone the runtime repository and start building autonomous, privacy-first multi-agent systems on your own hardware.
      </p>
      <div class="flex justify-center gap-4 pt-2 font-mono text-xs font-bold">
        <a href="https://github.com/DDS-Solutions/AI-TadPole-OS" class="px-8 py-3.5 bg-white text-zinc-950 rounded-xl hover:bg-zinc-200 transition-all uppercase tracking-wider">
          Clone Runtime Repo
        </a>
        <a href={`${basePath}/mission`} class="px-8 py-3.5 border border-white/20 bg-white/5 text-white rounded-xl hover:border-emerald-400 hover:text-emerald-300 transition-all uppercase tracking-wider">
          Launch Mission Demo ➔
        </a>
      </div>
    </section>
  </main>

  <script is:inline>
    function howItWorksPage() {
      return {
        selectedNode: 'directive',
        activePerspective: 'it',

        selectNode(key) {
          this.selectedNode = key;
        },

        selectPerspective(key) {
          this.activePerspective = key;
        },

        getNodeClass(key) {
          if (this.selectedNode === key) {
            return 'border-emerald-500 bg-emerald-500/20 text-white font-bold shadow-lg';
          }
          return 'border-white/10 bg-black/40 text-zinc-400 hover:border-white/20';
        },

        getPerspectiveClass(key) {
          if (this.activePerspective === key) {
            return 'bg-emerald-500 text-zinc-950 font-bold border-emerald-400 shadow-lg';
          }
          return 'bg-black/40 text-zinc-400 border-white/10 hover:border-white/20';
        },

        nodes: {
          directive: {
            icon: '📄',
            title: 'Layer 1: Directive SOP Engine',
            subTitle: 'Human Intent & SOP Source of Truth',
            badge: 'Layer 1',
            description: 'Directives are versioned Markdown SOP documents living in directives/. They define clear goals, parameters, tool bindings, and edge cases. Directives represent human intent—keeping AI agents grounded without probabilistic drift.',
            specs: [
              { label: 'File Storage Location', val: 'directives/*.md' },
              { label: 'Metadata Schema', val: 'YAML Frontmatter' },
              { label: 'Validation Protocol', val: 'ADG-01 Static Analysis' }
            ],
            code: `---
name: "Security Audit Directive"
version: "1.2.0"
capabilities_required: ["shell:execute", "read_file"]
---
