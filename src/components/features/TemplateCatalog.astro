---
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const categories = [
  {
    number: "01",
    category: "Security & audit",
    title: "Codebase FFI vulnerability sentinel",
    description: "Inspect Rust/C boundaries, check memory safety, and retain cryptographic audit receipts.",
    detail: "10 agent roles",
  },
  {
    number: "02",
    category: "Engineering & GIS",
    title: "GraphRAG knowledge indexer",
    description: "Connect code structure with searchable embeddings to keep institutional knowledge within reach.",
    detail: "46 agent roles",
  },
  {
    number: "03",
    category: "Specialized & operations",
    title: "Self-annealing operations synthesizer",
    description: "Break down strategic directives, monitor telemetry, and coordinate self-correction loops.",
    detail: "53 agent roles",
  },
];
---

<section id="templates" class="section-shell template-section" aria-labelledby="templates-title">
  <div class="template-intro">
    <div>
      <span class="eyebrow">A head start for your industry</span>
      <h2 id="templates-title" class="section-heading">Built for the work<br />you actually do.</h2>
    </div>
    <p class="section-copy">Start with a specialized role. Inspect its directives, make it your own, and add it to your local swarm.</p>
  </div>

  <div class="catalog-feature">
    <div class="catalog-content">
      <span class="catalog-label"><span aria-hidden="true"></span>The industry catalog</span>
      <h3>223 roles.<br />25 industry collections.</h3>
      <p>From engineering and security to marketing, finance, spatial computing, and academic workflows. Find the right starting point for your team.</p>
      <a href="https://dds-solutions.github.io/AI-Tadpole-OS-Industry-Templates/" target="_blank" rel="noopener noreferrer" class="button-primary catalog-link" aria-label="Browse the agent catalog, opens in a new tab">
        Browse agent catalog
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </a>
      <span class="catalog-footnote">Search roles · Inspect directives · Customize</span>
    </div>
    <div class="catalog-preview">
      <div class="catalog-preview-bar" aria-hidden="true"><span>Industry agent library</span><span>Catalog preview</span></div>
      <div class="catalog-image-wrap">
        <img src={`${basePath}/assets/industry_templates_catalog.png`} alt="Industry agent catalog showing searchable role collections and agent directives" width="1680" height="1050" loading="lazy" decoding="async" />
        <button type="button" @click={`openLightbox('${basePath}/assets/industry_templates_catalog.png', 'Industry agent swarm catalog')`} aria-label="Zoom Full Resolution: industry agent catalog" class="catalog-zoom">
          <svg width="14" height="14" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M7 3H3v4m10-4h4v4M3 13v4h4m10-4v4h-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
          <span>Zoom Full Resolution</span>
        </button>
      </div>
    </div>
  </div>

  <div class="category-grid" aria-label="Example agent collections">
    {categories.map((item) => (
      <article class="category-card">
        <div class="category-topline"><span>{item.category}</span><span class="category-number">{item.number}</span></div>
        <h3>{item.title}</h3>
        <p>{item.description}</p>
        <span class="category-detail">{item.detail}</span>
      </article>
    ))}
  </div>
</section>

<style>
  .template-section { scroll-margin-top: 7rem; }
  .template-intro { display: grid; grid-template-columns: 1.12fr 0.88fr; align-items: end; gap: 4rem; margin-bottom: 3.5rem; }
  .template-intro .section-copy { max-width: 29rem; padding-bottom: 0.25rem; }
  .catalog-feature { display: grid; grid-template-columns: 0.9fr 1.3fr; align-items: center; gap: 2.5rem; padding: 2.75rem 0 2.75rem 2.75rem; overflow: hidden; border: 1px solid rgba(255,255,255,0.12); border-radius: 1.25rem; background: radial-gradient(ellipse at 0 0, rgba(16,185,129,0.08), transparent 65%), #0a1111; }
  .catalog-content { min-width: 0; }
  .catalog-label { display: inline-flex; align-items: center; gap: 0.5rem; font-family: var(--font-mono); font-size: 0.65rem; color: #99b6a9; }
  .catalog-label > span { width: 5px; height: 5px; background: #6ee7b7; border-radius: 50%; }
  .catalog-content h3 { color: #f0f6f2; font-size: clamp(1.7rem, 2.7vw, 2.5rem); line-height: 1.2; letter-spacing: -0.045em; font-weight: 500; margin: 1.4rem 0 1.1rem; }
  .catalog-content p { margin: 0; color: #a1b0a9; font-size: 0.9rem; line-height: 1.85; max-width: 24rem; }
  .catalog-link { margin-top: 1.75rem; }
  .catalog-footnote { display: block; margin-top: 1.2rem; font-size: 0.62rem; font-family: var(--font-mono); color: #8c9d95; line-height: 1.7; }
  .catalog-preview { min-width: 0; margin-right: -2rem; border: 1px solid rgba(255,255,255,0.16); border-radius: 0.75rem 0 0 0.75rem; overflow: hidden; box-shadow: -20px 22px 40px rgba(0,0,0,0.22); transform: perspective(1400px) rotateY(-4deg); transform-origin: left center; background: #080b0c; }
  .catalog-preview-bar { display: flex; justify-content: space-between; gap: 1rem; padding: 0.75rem 3rem 0.75rem 0.9rem; border-bottom: 1px solid rgba(255,255,255,0.08); color: #96a69d; font-size: 0.57rem; font-family: var(--font-mono); }
  .catalog-preview-bar span:last-child { color: #6ee7b7; }
  .catalog-image-wrap { position: relative; }
  .catalog-image-wrap img { display: block; width: 100%; height: auto; }
  .catalog-zoom { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; position: absolute; right: 3rem; bottom: 0.8rem; min-height: 40px; border: 1px solid rgba(255,255,255,0.25); border-radius: 0.5rem; background: rgba(5,12,12,0.94); padding: 0.65rem 0.8rem; color: #e2ede8; font-size: 0.6rem; font-family: var(--font-mono); cursor: pointer; transition: background 180ms, border-color 180ms; }
  .catalog-zoom:hover { background: #10251e; border-color: #6ee7b7; }
  .catalog-zoom:focus-visible { outline: 2px solid #6ee7b7; outline-offset: 3px; }
  .category-grid { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 1.25rem; margin-top: 1.25rem; }
  .category-card { display: flex; flex-direction: column; padding: 1.65rem; border: 1px solid rgba(255,255,255,0.1); border-radius: 0.85rem; background: rgba(255,255,255,0.015); }
  .category-topline { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; color: #84c8af; font-size: 0.68rem; }
  .category-number { font-family: var(--font-mono); color: #788c82; font-size: 0.63rem; }
  .category-card h3 { margin: 1.5rem 0 0; color: #e4eee8; font-size: 1.15rem; font-weight: 500; letter-spacing: -0.025em; line-height: 1.45; }
  .category-card p { margin: 0.85rem 0 1.5rem; font-size: 0.82rem; line-height: 1.8; color: #98a79e; }
  .category-detail { margin-top: auto; font-family: var(--font-mono); font-size: 0.62rem; color: #9cafa4; }
  @media (max-width: 1000px) {
    .catalog-feature { gap: 1.75rem; padding: 2rem 0 2rem 2rem; }
    .category-card { padding: 1.35rem; }
  }
  @media (max-width: 760px) {
    .template-intro { grid-template-columns: 1fr; gap: 1.3rem; margin-bottom: 2rem; }
    .catalog-feature { grid-template-columns: 1fr; padding: 1.75rem; gap: 2rem; }
    .catalog-content p { max-width: 100%; }
    .catalog-content h3 { font-size: 2rem; }
    .catalog-preview { margin-right: 0; border-radius: 0.6rem; transform: none; }
    .catalog-preview-bar { padding: 0.7rem; font-size: 0.5rem; }
    .catalog-zoom { right: 0.5rem; bottom: 0.5rem; min-height: 36px; padding: 0.45rem 0.55rem; font-size: 0.56rem; }
    .category-grid { grid-template-columns: 1fr; }
    .category-card { padding: 1.5rem; }
    .category-card h3 { margin-top: 1.1rem; }
  }
</style>
