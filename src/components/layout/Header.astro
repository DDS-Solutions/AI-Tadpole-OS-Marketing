---
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-zinc-950/80 backdrop-blur-xl"
>
  <div
    class="mx-auto flex h-20 max-w-7xl items-center justify-between px-5 sm:px-8"
  >
    <a
      href={`${basePath}/`}
      class="flex min-h-11 items-center gap-3 rounded-lg text-zinc-100 outline-offset-4"
      aria-label="AI-Tadpole-OS home"
    >
      <img
        src={`${basePath}/assets/brand/tadpole-mark-96.png`}
        alt="AI-Tadpole-OS logo"
        width="96"
        height="96"
        decoding="async"
        class="h-10 w-10 rounded-lg border border-white/10 object-cover"
      />
      <span class="hidden text-sm font-bold tracking-tight sm:block"
        >AI-Tadpole-OS</span
      >
    </a>
    <nav
      class="hidden items-center gap-8 text-xs font-bold uppercase tracking-[0.18em] text-zinc-400 md:flex"
      aria-label="Primary navigation"
    >
      <a class="hover:text-zinc-100" href={`${basePath}/#runtime`}>Runtime</a>
      <a class="hover:text-zinc-100" href={`${basePath}/#interface`}>Interface</a>
      <a class="hover:text-zinc-100" href={`${basePath}/how-it-works`}>How It Works</a>
      <a class="hover:text-zinc-100" href={`${basePath}/mission`}>Mission</a>
      <a class="hover:text-zinc-100" href={`${basePath}/governance`}>Governance</a>
      <a class="hover:text-zinc-100" href={`${basePath}/#templates`}>Templates</a>
      <a class="hover:text-zinc-100" href={`${basePath}/#roadmap`}>Roadmap</a>
    </nav>
    <details class="relative md:hidden">
      <summary
        class="flex min-h-11 cursor-pointer list-none items-center rounded-lg border border-white/10 px-4 text-xs font-bold uppercase tracking-[0.16em] text-zinc-200 marker:content-none hover:border-emerald-300 hover:text-emerald-300"
      >
        Menu
      </summary>
      <nav
        class="absolute right-0 top-14 w-56 rounded-xl border border-white/10 bg-zinc-950/95 p-2 shadow-2xl backdrop-blur-xl"
        aria-label="Mobile navigation"
      >
        <a class="block rounded-lg px-3 py-3 text-sm text-zinc-300 hover:bg-white/10 hover:text-white" href={`${basePath}/#runtime`}>Runtime</a>
        <a class="block rounded-lg px-3 py-3 text-sm text-zinc-300 hover:bg-white/10 hover:text-white" href={`${basePath}/#interface`}>Interface</a>
        <a class="block rounded-lg px-3 py-3 text-sm text-zinc-300 hover:bg-white/10 hover:text-white" href={`${basePath}/how-it-works`}>How It Works</a>
        <a class="block rounded-lg px-3 py-3 text-sm text-zinc-300 hover:bg-white/10 hover:text-white" href={`${basePath}/mission`}>Mission</a>
        <a class="block rounded-lg px-3 py-3 text-sm text-zinc-300 hover:bg-white/10 hover:text-white" href={`${basePath}/governance`}>Governance</a>
        <a class="block rounded-lg px-3 py-3 text-sm text-zinc-300 hover:bg-white/10 hover:text-white" href={`${basePath}/#templates`}>Templates</a>
        <a class="block rounded-lg px-3 py-3 text-sm text-zinc-300 hover:bg-white/10 hover:text-white" href={`${basePath}/#roadmap`}>Roadmap</a>
      </nav>
    </details>
    <a
      href="https://github.com/DDS-Solutions/AI-TadPole-OS"
      class="inline-flex min-h-11 items-center rounded-lg border border-emerald-400/30 bg-emerald-400/10 px-4 text-xs font-bold uppercase tracking-[0.16em] text-emerald-300 hover:border-emerald-300 hover:bg-emerald-300 hover:text-zinc-950"
    >
      Source
    </a>
  </div>
</header>
