---
import BaseLayout from "../layouts/BaseLayout.astro";
const basePath = '/AI-Tadpole-OS-Marketing';
---

<style>
  .font-mono-code {
    font-family: "JetBrains Mono", monospace;
  }

  .scanline-bg {
    background: linear-gradient(
      to bottom,
      rgba(255,255,255,0),
      rgba(255,255,255,0) 50%,
      rgba(16, 185, 129, 0.02) 50%,
      rgba(16, 185, 129, 0.02)
    );
    background-size: 100% 4px;
  }

  .glow-emerald-box {
    box-shadow: 0 0 35px rgba(16, 185, 129, 0.15);
  }
</style>

<BaseLayout
  title="Sovereign Protocol & Governance Whitepaper | AI-Tadpole-OS"
  description="The technical governance, zero-trust security contracts, and ethical framework for AI-Tadpole-OS sovereign multi-agent swarms."
>
  <main
    id="main"
    class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 py-20 md:py-28 space-y-20"
    x-data="governancePage()"
  >
    <!-- Header -->
    <header class="text-center space-y-6 max-w-4xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-emerald-500/20 bg-emerald-500/10 text-emerald-400 font-mono text-xs uppercase tracking-widest backdrop-blur">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
        Sovereign Protocol Specification v1.2.1
      </div>
      <h1 class="text-5xl sm:text-7xl lg:text-8xl font-extrabold tracking-tight text-white font-outfit leading-[0.95]">
        Protocol <span class="bg-gradient-to-r from-emerald-400 via-teal-300 to-cyan-400 bg-clip-text text-transparent">Governance</span>
      </h1>
      <p class="text-base sm:text-lg text-zinc-400 font-light leading-relaxed max-w-2xl mx-auto">
        The official technical and ethical whitepaper governing <strong>Entity 0 (The Overlord)</strong>, 
        <strong>Sapphire Shield Zero-Trust Gates</strong>, and <strong>Air-Gapped Sovereign Execution</strong>.
      </p>
    </header>

    <!-- INTERACTIVE GOVERNANCE CLAUSE SELECTOR -->
    <section class="glass-surface rounded-3xl border border-white/10 overflow-hidden shadow-2xl p-6 sm:p-10 space-y-8 scanline-bg glow-emerald-box">
      <!-- Nav Tabs -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 font-mono text-xs" role="tablist" aria-label="Governance sections">
        <button
          @click="activeTab = 'overlord'"
          role="tab"
          :aria-selected="activeTab === 'overlord'"
          :class="activeTab === 'overlord' ? 'border-emerald-500 bg-emerald-500/15 text-white font-bold' : 'border-white/10 bg-black/40 text-zinc-400 hover:border-white/20'"
          class="p-4 rounded-2xl border text-left transition-all duration-200 space-y-1"
        >
          <div class="text-[10px] text-emerald-400 uppercase font-bold tracking-widest">Section I</div>
          <div class="text-sm font-bold text-white font-outfit">The Overlord (Entity 0)</div>
        </button>

        <button
          @click="activeTab = 'sovereignty'"
          role="tab"
          :aria-selected="activeTab === 'sovereignty'"
          :class="activeTab === 'sovereignty' ? 'border-cyan-500 bg-cyan-500/15 text-white font-bold' : 'border-white/10 bg-black/40 text-zinc-400 hover:border-white/20'"
          class="p-4 rounded-2xl border text-left transition-all duration-200 space-y-1"
        >
          <div class="text-[10px] text-cyan-400 uppercase font-bold tracking-widest">Section II</div>
          <div class="text-sm font-bold text-white font-outfit">Sovereign Execution</div>
        </button>

        <button
          @click="activeTab = 'sapphire'"
          role="tab"
          :aria-selected="activeTab === 'sapphire'"
          :class="activeTab === 'sapphire' ? 'border-amber-500 bg-amber-500/15 text-white font-bold' : 'border-white/10 bg-black/40 text-zinc-400 hover:border-white/20'"
          class="p-4 rounded-2xl border text-left transition-all duration-200 space-y-1"
        >
          <div class="text-[10px] text-amber-400 uppercase font-bold tracking-widest">Section III</div>
          <div class="text-sm font-bold text-white font-outfit">Sapphire Shield Gate</div>
        </button>

        <button
          @click="activeTab = 'scaling'"
          role="tab"
          :aria-selected="activeTab === 'scaling'"
          :class="activeTab === 'scaling' ? 'border-purple-500 bg-purple-500/15 text-white font-bold' : 'border-white/10 bg-black/40 text-zinc-400 hover:border-white/20'"
          class="p-4 rounded-2xl border text-left transition-all duration-200 space-y-1"
        >
          <div class="text-[10px] text-purple-400 uppercase font-bold tracking-widest">Section IV</div>
          <div class="text-sm font-bold text-white font-outfit">Scalability & EBITDA Moat</div>
        </button>
      </div>

      <!-- Section Details Viewport -->
      <div class="p-6 sm:p-8 rounded-2xl bg-zinc-950/90 border border-white/10 space-y-8">
        
        <!-- SECTION I: OVERLORD -->
        <div x-show="activeTab === 'overlord'" class="space-y-6 animate-fadeIn">
          <div class="flex items-center gap-3 border-b border-white/10 pb-4">
            <span class="text-3xl">👑</span>
            <div>
              <h3 class="text-2xl font-bold text-white font-outfit">I. Entity 0 Protocol (The Overlord)</h3>
              <p class="text-xs font-mono text-emerald-400">Human Operator Final Authority & Global Cryptographic Killswitch</p>
            </div>
          </div>

          <p class="text-base text-zinc-300 font-light leading-relaxed">
            In the AI-Tadpole-OS architecture, human operators hold the designation of <strong>Entity 0 (The Overlord)</strong>. 
            All multi-agent swarms operate strictly as subordinate intelligence layers beneath explicit human governance contracts.
          </p>

          <div class="grid md:grid-cols-3 gap-4 font-mono text-xs">
            <div class="p-4 rounded-xl bg-black/50 border border-white/5 space-y-2">
              <div class="text-emerald-400 font-bold uppercase text-[10px]">1. Oversight Gate</div>
              <p class="text-zinc-400 font-light text-[11px] leading-relaxed">
                Mandatory human verification for all high-risk capabilities (<code class="text-emerald-300">shell:execute</code>, <code class="text-emerald-300">budget:spend</code>).
              </p>
            </div>

            <div class="p-4 rounded-xl bg-black/50 border border-white/5 space-y-2">
              <div class="text-cyan-400 font-bold uppercase text-[10px]">2. Zero Context Decay</div>
              <p class="text-zinc-400 font-light text-[11px] leading-relaxed">
                Autonomous missions persist beyond session boundaries with zero objective drift.
              </p>
            </div>

            <div class="p-4 rounded-xl bg-black/50 border border-white/5 space-y-2">
              <div class="text-red-400 font-bold uppercase text-[10px]">3. Red Button Killswitch</div>
              <p class="text-zinc-400 font-light text-[11px] leading-relaxed">
                Global cryptographic killswitch to freeze all Tokio execution loops instantly.
              </p>
            </div>
          </div>
        </div>

        <!-- SECTION II: SOVEREIGN EXECUTION -->
        <div x-show="activeTab === 'sovereignty'" class="space-y-6 animate-fadeIn">
          <div class="flex items-center gap-3 border-b border-white/10 pb-4">
            <span class="text-3xl">🏰</span>
            <div>
              <h3 class="text-2xl font-bold text-white font-outfit">II. Absolute Data Sovereignty</h3>
              <p class="text-xs font-mono text-cyan-400">Air-Gapped Operation When Configured</p>
            </div>
          </div>

          <p class="text-base text-zinc-300 font-light leading-relaxed">
            AI-Tadpole-OS is built on the foundation of <strong>Hardware-Level Intelligence Ownership</strong>. 
            Enterprises store all directives, vector databases, and execution histories locally—eliminating vendor lock-in and cloud data leaks.
          </p>

          <div class="grid md:grid-cols-2 gap-6">
            <div class="p-5 rounded-xl bg-black/50 border border-emerald-500/30 space-y-2 font-mono text-xs">
              <div class="text-emerald-300 font-bold">LanceDB Private Vector Store</div>
              <p class="text-zinc-400 font-light leading-relaxed">
                Directives, traversal graphs, and GraphRAG entities can remain on local storage under your deployment's configured security controls.
              </p>
            </div>

            <div class="p-5 rounded-xl bg-black/50 border border-cyan-500/30 space-y-2 font-mono text-xs">
              <div class="text-cyan-300 font-bold">Hard Privacy Gate</div>
              <p class="text-zinc-400 font-light leading-relaxed">
                Explicit network firewall flag blocking external cloud API requests for mission-critical confidentiality.
              </p>
            </div>
          </div>
        </div>

        <!-- SECTION III: SAPPHIRE SHIELD -->
        <div x-show="activeTab === 'sapphire'" class="space-y-6 animate-fadeIn">
          <div class="flex items-center gap-3 border-b border-white/10 pb-4">
            <span class="text-3xl">🛡️</span>
            <div>
              <h3 class="text-2xl font-bold text-white font-outfit">III. Sapphire Shield Zero-Trust Gate</h3>
              <p class="text-xs font-mono text-amber-400">Declarative Template Swarms & Cryptographic Audit Proofs</p>
            </div>
          </div>

          <p class="text-base text-zinc-300 font-light leading-relaxed">
            All template swarms are strictly declarative (JSON/Markdown) with zero raw executable code allowed. 
            Any dynamic capability escalation freezes the runtime instantly until signed with an immutable <strong>Merkle-Proof Audit Receipt</strong>.
          </p>

          <div class="p-4 rounded-xl bg-black border border-white/10 font-mono text-xs space-y-2 text-zinc-300">
            <div class="text-amber-400 font-bold uppercase text-[10px]">Sample Merkle Proof Audit Contract</div>
            <pre class="text-emerald-400 leading-relaxed overflow-x-auto p-2 bg-zinc-950 rounded">
&#123;
  "governance_version": "1.2.1",
  "capability_requested": "shell:execute",
  "intercept_gate": "SapphireShield_v2",
  "signed_by": "Entity_0_Overlord",
  "merkle_root": "0x7f83a91b2c4e5d6f081726345890abcdef1234567890fedcba0987654321ffff"
&#125;</pre>
          </div>
        </div>

        <!-- SECTION IV: SCALABILITY & EBITDA MOAT -->
        <div x-show="activeTab === 'scaling'" class="space-y-6 animate-fadeIn">
          <div class="flex items-center gap-3 border-b border-white/10 pb-4">
            <span class="text-3xl">🔱</span>
            <div>
              <h3 class="text-2xl font-bold text-white font-outfit">IV. Enterprise Scalability & EBITDA Moat</h3>
              <p class="text-xs font-mono text-purple-400">Transition from Tadpole Pilot to Big Frog Swarms</p>
            </div>
          </div>

          <p class="text-base text-zinc-300 font-light leading-relaxed">
            By leveraging Rust Tokio concurrency, small agile teams can orchestrate 50+ specialist agents simultaneously—delivering weeks of documentation, audits, and research in hours.
          </p>

          <blockquote class="border-l-4 border-emerald-500 pl-6 text-lg italic text-zinc-200 font-light font-outfit">
            "The future belongs to small teams wielding sovereign, parallel intelligence swarms."
          </blockquote>
        </div>

      </div>
    </section>

    <!-- COMPLIANCE & STANDARDS MATRIX -->
    <section class="space-y-8">
      <div class="text-center space-y-3">
        <h2 class="text-3xl font-bold text-white font-outfit">Sovereign Compliance Standards</h2>
        <p class="text-xs font-mono text-zinc-400 uppercase tracking-widest">Built for ISO, GxP, and NIST AI Governance</p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 font-mono text-xs">
        <div class="p-6 rounded-2xl glass-surface border border-white/10 space-y-2">
          <div class="text-emerald-400 font-bold text-base">ISO 9001 / 42001</div>
          <p class="text-zinc-400 text-xs font-light">Quality management & AI management systems compliance.</p>
        </div>

        <div class="p-6 rounded-2xl glass-surface border border-white/10 space-y-2">
          <div class="text-cyan-400 font-bold text-base">NIST AI-RMF</div>
          <p class="text-zinc-400 text-xs font-light">Risk Management Framework map & zero-trust boundaries.</p>
        </div>

        <div class="p-6 rounded-2xl glass-surface border border-white/10 space-y-2">
          <div class="text-purple-400 font-bold text-base">ALCOA+ Standard</div>
          <p class="text-zinc-400 text-xs font-light">Attributable, legible, contemporaneous, original audit logs.</p>
        </div>

        <div class="p-6 rounded-2xl glass-surface border border-white/10 space-y-2">
          <div class="text-amber-400 font-bold text-base">GxP Regulatory</div>
          <p class="text-zinc-400 text-xs font-light">Validated software execution for life sciences & medical.</p>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <footer class="pt-16 border-t border-white/10 text-center space-y-8 pb-12">
      <div class="space-y-3">
        <h3 class="text-2xl font-bold text-white font-outfit">Ready to Deploy Governed Swarms?</h3>
        <p class="text-xs text-zinc-400 font-mono">Explore the core source code or launch a live simulation.</p>
      </div>

      <div class="flex flex-wrap justify-center gap-4 font-mono text-xs font-bold">
        <a
          href="https://github.com/DDS-Solutions/AI-TadPole-OS"
          class="px-8 py-3.5 bg-white text-zinc-950 rounded-xl hover:bg-zinc-200 transition-all uppercase tracking-wider shadow-lg"
        >
          View GitHub Repository
        </a>
        <a
          href={`${basePath}/mission`}
          class="px-8 py-3.5 border border-white/20 bg-white/5 text-white rounded-xl hover:border-emerald-400 hover:text-emerald-300 transition-all uppercase tracking-wider"
        >
          Test Mission Simulator ➔
        </a>
      </div>
    </footer>
  </main>
</BaseLayout>
