---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/features/Hero.astro";
import ArchitectureLayers from "../components/features/ArchitectureLayers.astro";
import ScreenshotGallery from "../components/features/ScreenshotGallery.astro";
import TemplateCatalog from "../components/features/TemplateCatalog.astro";
import Roadmap from "../components/features/Roadmap.astro";
import BottomCta from "../components/features/BottomCta.astro";
import LightboxModal from "../components/ui/LightboxModal.astro";
---

<BaseLayout
  title="AI-Tadpole-OS | Local-First Multi-Agent Swarm Runtime"
  description="AI-Tadpole-OS is a local-first Rust and React runtime for sovereign multi-agent orchestration, live telemetry, model routing, and human-governed execution."
>
  <main id="main" class="relative z-10 space-y-24 pb-24" x-data="homepage()">
    <Hero />
    <ArchitectureLayers />
    <ScreenshotGallery />
    <TemplateCatalog />
    <Roadmap />
    <BottomCta />
    <LightboxModal />
  </main>
</BaseLayout>
