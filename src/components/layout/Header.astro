---
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const navLinks = [
  { href: `${basePath}/#runtime`, label: "Product" },
  { href: `${basePath}/how-it-works/`, label: "Architecture" },
  { href: `${basePath}/governance/`, label: "Governance" },
  { href: `${basePath}/#templates`, label: "Templates" },
];
const mobileLinks = [
  ...navLinks,
  { href: `${basePath}/#interface`, label: "Desktop interface" },
  { href: `${basePath}/mission/`, label: "Mission walkthrough" },
  { href: `${basePath}/#roadmap`, label: "Engineering roadmap" },
];
const currentPath = Astro.url.pathname.replace(/\/$/, "");
---

<header class="site-header">
  <div class="section-shell header-inner">
    <a href={`${basePath}/`} class="brand" aria-label="AI-Tadpole-OS home">
      <img
        src={`${basePath}/assets/brand/tadpole-mark-96.png`}
        alt=""
        width="96"
        height="96"
        decoding="async"
      />
      <span>AI-Tadpole-OS<span class="brand-os"></span></span>
    </a>
    <nav class="desktop-nav" aria-label="Primary navigation">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            aria-current={
              link.href.replace(/\/$/, "") === currentPath ? "page" : undefined
            }
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="header-actions">
      <a
        href="https://github.com/DDS-Solutions/AI-TadPole-OS"
        class="source-link"
        aria-label="AI-Tadpole-OS source on GitHub"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
          ><path
            d="M9 19c-4 1-4-2-6-2m12 5v-4a3.5 3.5 0 0 0-1-3c3-.4 6-1.5 6-6a5 5 0 0 0-1.4-3.5 4.6 4.6 0 0 0-.1-3.5S17.4 1.6 15 3a12 12 0 0 0-6 0C6.6 1.6 5.5 2 5.5 2a4.6 4.6 0 0 0-.1 3.5A5 5 0 0 0 4 9c0 4.5 3 5.6 6 6a3.5 3.5 0 0 0-1 3v4"
          ></path></svg
        ><span>Source</span>
      </a>
      <a href={`${basePath}/mission/`} class="header-cta"
        >Explore the mission <span aria-hidden="true">↗</span></a
      >
      <details class="mobile-menu">
        <summary aria-label="Navigation menu"
          ><span class="menu-icon" aria-hidden="true"
            ><span></span><span></span></span
          ><span>Menu</span></summary
        >
        <nav aria-label="Mobile navigation">
          <span class="mobile-nav-label">EXPLORE TADPOLE OS</span>
          {
            mobileLinks.map((link) => (
              <a
                href={link.href}
                aria-current={
                  link.href.replace(/\/$/, "") === currentPath
                    ? "page"
                    : undefined
                }
              >
                {link.label}
                <span aria-hidden="true">↗</span>
              </a>
            ))
          }
          <a href="https://github.com/DDS-Solutions/AI-TadPole-OS"
            >Source on GitHub<span aria-hidden="true">↗</span></a
          >
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  const closeMenu = (restoreFocus = false) => {
    const menu =
      document.querySelector<HTMLDetailsElement>(".mobile-menu[open]");
    if (!menu) return;
    menu.open = false;
    if (restoreFocus) menu.querySelector("summary")?.focus();
  };
  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const menu = document.querySelector(".mobile-menu[open]");
    if (menu && (!menu.contains(target) || target.closest("a"))) closeMenu();
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeMenu(true);
  });
  document.addEventListener("focusin", (event) => {
    const menu = document.querySelector(".mobile-menu[open]");
    if (menu && event.target instanceof Node && !menu.contains(event.target))
      closeMenu();
  });
  document.addEventListener("astro:before-swap", () => closeMenu());
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    background: #090b0be8;
    backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--line);
  }
  .header-inner {
    height: 76px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }
  .brand {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 0.7rem;
    font-size: 1.15rem;
    font-weight: 650;
    letter-spacing: -0.04em;
    flex-shrink: 0;
  }
  .brand img {
    width: 34px;
    height: 34px;
    object-fit: cover;
    border-radius: 9px;
    border: 1px solid #ffffff15;
  }
  .brand-os {
    color: #a1a1aa;
    margin-left: 0.3rem;
    font-weight: 400;
  }
  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }
  .desktop-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: #a1a1aa;
    font-size: 0.76rem;
    transition: color 180ms;
  }
  .desktop-nav a:hover,
  .desktop-nav a[aria-current] {
    color: #a7f3d0;
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .source-link {
    min-height: 44px;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #a1a1aa;
    font-size: 0.72rem;
  }
  .source-link:hover {
    color: white;
  }
  .source-link svg {
    width: 17px;
    height: 17px;
  }
  .header-cta {
    display: inline-flex;
    align-items: center;
    gap: 1.25rem;
    min-height: 40px;
    border: 1px solid #6ee7b730;
    border-radius: 6px;
    padding: 0.55rem 0.9rem;
    background: #6ee7b709;
    color: #a7f3d0;
    font-size: 0.7rem;
    font-weight: 550;
    transition:
      background 180ms,
      border-color 180ms;
  }
  .header-cta:hover {
    background: #6ee7b717;
    border-color: #6ee7b780;
  }
  .mobile-menu {
    display: none;
    position: relative;
  }
  summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    gap: 0.6rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid #ffffff20;
    border-radius: 6px;
    font-size: 0.75rem;
    color: #e4e4e7;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .menu-icon {
    display: grid;
    gap: 4px;
    width: 14px;
  }
  .menu-icon span {
    height: 1px;
    background: currentColor;
  }
  .mobile-menu nav {
    position: absolute;
    right: 0;
    top: calc(100% + 1rem);
    width: min(310px, calc(100vw - 2.5rem));
    max-height: calc(100dvh - 100px);
    overflow-y: auto;
    padding: 0.65rem;
    border: 1px solid #ffffff20;
    border-radius: 10px;
    background: #0e1312fa;
    box-shadow: 0 20px 80px #0008;
    backdrop-filter: blur(20px);
  }
  .mobile-nav-label {
    display: block;
    font: 0.55rem var(--font-mono);
    letter-spacing: 0.16em;
    color: #a1a1aa;
    padding: 0.8rem 0.75rem;
  }
  .mobile-menu nav a {
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem;
    border-radius: 5px;
    font-size: 0.8rem;
    color: #d4d4d8;
  }
  .mobile-menu nav a span {
    color: #6ee7b7;
  }
  .mobile-menu nav a:hover,
  .mobile-menu nav a[aria-current] {
    background: #6ee7b70a;
    color: #a7f3d0;
  }
  @media (max-width: 1023px) {
    .desktop-nav {
      display: none;
    }
    .mobile-menu {
      display: block;
    }
  }
  @media (max-width: 639px) {
    .header-inner {
      height: 68px;
      gap: 0.75rem;
    }
    .header-actions {
      gap: 0.75rem;
    }
    .header-cta,
    .source-link {
      display: none;
    }
    .brand {
      font-size: 1.05rem;
    }
  }
</style>
