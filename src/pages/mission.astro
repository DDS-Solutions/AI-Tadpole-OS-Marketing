---
import BaseLayout from "../layouts/BaseLayout.astro";
const basePath = '/AI-Tadpole-OS-Marketing';
---

<style>
  .terminal-font {
    font-family: "JetBrains Mono", monospace;
  }
  
  .terminal-scroll::-webkit-scrollbar {
    width: 6px;
  }
  .terminal-scroll::-webkit-scrollbar-track {
    background: rgba(0, 0, 0, 0.4);
  }
  .terminal-scroll::-webkit-scrollbar-thumb {
    background: rgba(16, 185, 129, 0.3);
    border-radius: 3px;
  }

  .scanline {
    background: linear-gradient(
      to bottom,
      rgba(255,255,255,0),
      rgba(255,255,255,0) 50%,
      rgba(16, 185, 129, 0.02) 50%,
      rgba(16, 185, 129, 0.02)
    );
    background-size: 100% 4px;
  }
</style>

<BaseLayout
  title="Mission Runtime Experience | AI-Tadpole-OS Sovereign Protocol"
  description="Explore authentic screenshots and step-by-step walkthrough of the AI-Tadpole-OS mission runtime, captured directly from the live React desktop engine."
>
  <main
    class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 py-20 md:py-28 space-y-20"
    x-data="missionPage()"
  >
    <!-- Page Header -->
    <header class="text-center space-y-6 max-w-4xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-emerald-500/20 bg-emerald-500/10 text-emerald-400 font-mono text-xs uppercase tracking-widest backdrop-blur">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
        Live Desktop Runtime Walkthrough
      </div>
      <h1 class="text-5xl sm:text-7xl lg:text-8xl font-extrabold tracking-tight text-white font-outfit leading-[0.95]">
        Sovereign Swarm <span class="bg-gradient-to-r from-emerald-400 via-teal-300 to-cyan-400 bg-clip-text text-transparent">Missions</span>
      </h1>
      <p class="text-base sm:text-lg text-zinc-400 font-light leading-relaxed max-w-2xl mx-auto">
        Step inside the authentic **Tadpole OS Runtime** captured live from <code class="text-emerald-400 font-mono text-xs bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20">http://localhost:5173/missions</code>. 
        Witness multi-agent orchestration, OTel neural traces, and zero-trust execution controls.
      </p>
    </header>

    <!-- SECTION 1: REAL UI SLIDESHOW SHOWCASE -->
    <section class="glass-surface rounded-3xl border border-white/10 overflow-hidden shadow-2xl relative scanline p-6 sm:p-8 space-y-8">
      
      <!-- Top Title & Controls -->
      <div class="flex flex-wrap items-center justify-between gap-4 border-b border-white/10 pb-6">
        <div>
          <div class="flex items-center gap-3">
            <h2 class="text-2xl font-bold text-white font-outfit">Live Application Walkthrough</h2>
            <span class="px-2.5 py-0.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-[10px] font-mono font-bold uppercase tracking-wider">
              6 Real Screenshots
            </span>
          </div>
          <p class="text-xs text-zinc-400 mt-1 font-mono">
            Captured directly from the local React + Rust desktop engine.
          </p>
        </div>

        <div class="flex items-center gap-3 font-mono text-xs">
          <!-- Auto-Play Toggle -->
          <button
            @click="toggleAutoPlay()"
            :class="autoPlay ? 'border-emerald-500/40 bg-emerald-500/10 text-emerald-300' : 'border-white/10 bg-black/40 text-zinc-400'"
            class="px-3.5 py-2 rounded-xl border transition-all flex items-center gap-2"
          >
            <span x-text="autoPlay ? '⏸ Pause Slideshow' : '▶ Auto-Play Slideshow'"></span>
          </button>

          <!-- Prev/Next -->
          <div class="flex items-center gap-1.5 bg-black/40 p-1 rounded-xl border border-white/10">
            <button
              @click="prevSlide()"
              class="px-3 py-1.5 rounded-lg hover:bg-white/10 text-white font-bold transition-colors"
              title="Previous slide (Left Arrow)"
            >
              ← Prev
            </button>
            <span class="text-zinc-500 px-2 font-mono" x-text="(currentSlide + 1) + ' / ' + slides.length"></span>
            <button
              @click="nextSlide()"
              class="px-3 py-1.5 rounded-lg hover:bg-white/10 text-white font-bold transition-colors"
              title="Next slide (Right Arrow)"
            >
              Next →
            </button>
          </div>
        </div>
      </div>

      <!-- Slide Nav Tabs -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2 font-mono text-xs">
        <template x-for="(slide, idx) in slides" :key="idx">
          <button
            @click="setSlide(idx)"
            :class="currentSlide === idx ? 'border-emerald-500/60 bg-emerald-500/10 text-white shadow-[0_0_15px_rgba(16,185,129,0.15)] font-bold' : 'border-white/5 bg-black/30 text-zinc-400 hover:border-white/15 hover:text-zinc-200'"
            class="p-3 rounded-xl border text-left transition-all duration-200 space-y-1"
          >
            <div class="text-[10px] text-zinc-500 uppercase tracking-widest" x-text="'STEP 0' + (idx + 1)"></div>
            <div class="text-xs truncate font-outfit font-semibold" x-text="slide.shortTitle"></div>
          </button>
        </template>
      </div>

      <!-- Main Active Slide Display -->
      <div class="grid lg:grid-cols-12 gap-8 items-start pt-2">
        <!-- Screenshot Container (8 cols) -->
        <div class="lg:col-span-8 space-y-4">
          <div class="relative group rounded-2xl overflow-hidden border border-white/15 shadow-2xl bg-black">
            <!-- Actual Screenshot Image -->
            <img
              :src="slides[currentSlide].image"
              :alt="slides[currentSlide].title"
              class="w-full h-auto object-cover rounded-2xl transition-transform duration-500 group-hover:scale-[1.01]"
              loading="eager"
            />

            <!-- Lightbox Zoom Overlay Hint -->
            <button
              @click="openLightbox(slides[currentSlide].image)"
              class="absolute bottom-4 right-4 bg-zinc-950/80 hover:bg-zinc-950 border border-white/20 text-white px-3 py-1.5 rounded-lg text-xs font-mono flex items-center gap-1.5 opacity-90 transition-opacity backdrop-blur"
            >
              <span>🔍 Zoom Full Resolution</span>
            </button>
          </div>

          <!-- Progress Bar for Auto Play -->
          <div x-show="autoPlay" class="h-1 bg-zinc-900 rounded-full overflow-hidden border border-white/5">
            <div
              class="h-full bg-emerald-400 transition-all duration-100 ease-linear"
              :style="'width: ' + autoPlayProgress + '%'"
            ></div>
          </div>
        </div>

        <!-- Slide Detail Sidebar (4 cols) -->
        <div class="lg:col-span-4 space-y-6 glass-surface p-6 rounded-2xl border border-white/10 bg-black/40">
          <div class="space-y-2">
            <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 font-mono text-[10px] uppercase font-bold">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
              <span x-text="slides[currentSlide].badge"></span>
            </div>
            <h3 class="text-2xl font-bold text-white font-outfit" x-text="slides[currentSlide].title"></h3>
          </div>

          <p class="text-sm text-zinc-300 font-light leading-relaxed" x-text="slides[currentSlide].description"></p>

          <div class="space-y-3 pt-3 border-t border-white/10 font-mono text-xs">
            <div class="text-zinc-500 font-bold uppercase text-[10px] tracking-wider">Protocol Verification Metrics</div>
            
            <template x-for="(metric, mIdx) in slides[currentSlide].metrics" :key="mIdx">
              <div class="flex justify-between items-center py-1.5 border-b border-white/5">
                <span class="text-zinc-400" x-text="metric.label"></span>
                <span class="text-emerald-300 font-bold" x-text="metric.value"></span>
              </div>
            </template>
          </div>

          <div class="p-3.5 rounded-xl bg-zinc-950/80 border border-white/10 font-mono text-xs text-zinc-400 space-y-1">
            <div class="text-[10px] text-zinc-500 uppercase font-bold">Real Telemetry Log Snippet</div>
            <div class="text-emerald-400/90 leading-relaxed font-mono text-[11px]" x-html="slides[currentSlide].logSnippet"></div>
          </div>
        </div>
      </div>

    </section>

    <!-- LIGHTBOX MODAL FOR FULL RESOLUTION SCREENSHOTS -->
    <div
      x-show="lightboxOpen"
      x-transition:enter="transition ease-out duration-300"
      x-transition:enter-start="opacity-0 scale-95"
      x-transition:enter-end="opacity-100 scale-100"
      x-transition:leave="transition ease-in duration-200"
      x-transition:leave-start="opacity-100 scale-100"
      x-transition:leave-end="opacity-0 scale-95"
      class="fixed inset-0 z-50 bg-black/90 backdrop-blur-xl flex items-center justify-center p-4 sm:p-8"
      @click.self="lightboxOpen = false"
    >
      <div class="relative max-w-6xl max-h-[90vh] w-full flex flex-col items-center">
        <button
          @click="lightboxOpen = false"
          class="absolute -top-12 right-0 text-zinc-400 hover:text-white font-mono text-sm uppercase px-3 py-1 bg-white/10 rounded-lg border border-white/10"
        >
          ✕ Close Full Screen
        </button>
        <img :src="lightboxImg" class="max-h-[85vh] w-auto object-contain rounded-xl border border-white/20 shadow-2xl" />
      </div>
    </div>

  </main>

  <script is:inline>
    function missionPage() {
      return {
        currentSlide: 0,
        autoPlay: true,
        autoPlayProgress: 0,
        autoPlayTimer: null,
        progressTimer: null,
        lightboxOpen: false,
        lightboxImg: '',

        basePath: '/AI-Tadpole-OS-Marketing',

        slides: [
          {
            shortTitle: 'Swarm Init',
            badge: 'Phase 1: Cluster Initialization',
            title: 'Swarm & Cluster Initialization',
            image: '/AI-Tadpole-OS-Marketing/assets/real_mission/step1_initial_state.png',
            description: 'The OS scans active swarm clusters. The Strategic Command cluster (cl-command) is initialized with 60 Nodes online and a $100.00 execution budget in workspace /workspaces/strategic-command.',
            metrics: [
              { label: 'Active Swarm Clusters', value: '4 / 5 Online' },
              { label: 'Swarm Node Density', value: '60 Nodes' },
              { label: 'Target Workspace', value: '/workspaces/strategic-command' }
            ],
            logSnippet: '<span class="text-cyan-400">[INIT]</span> Swarm Cluster Strategic Command mounted. 60 Nodes initialized.'
          },
          {
            shortTitle: 'Neural Sync',
            badge: 'Phase 2: GraphRAG Optimization',
            title: 'Neural Graph Optimization Proposal',
            image: '/AI-Tadpole-OS-Marketing/assets/real_mission/step2_neural_proposal.png',
            description: 'When entering a mission objective ("Execute Sovereign Security Audit on server-rs"), the AI-Tadpole-OS neural engine automatically proposes GraphRAG context synchronization across local LanceDB vectors.',
            metrics: [
              { label: 'Embedding Vector Engine', value: 'LanceDB (768-dim)' },
              { label: 'Authorization Status', value: 'Awaiting User Sync' },
              { label: 'Graph Triples', value: 'ISO 9001 / ALCOA+' }
            ],
            logSnippet: '<span class="text-amber-400">[PROPOSAL]</span> Neural context sync proposed for directive security_audit.md.'
          },
          {
            shortTitle: 'Mission Launch',
            badge: 'Phase 3: Telemetry Stream',
            title: 'Mission Launch & 10Hz Telemetry',
            image: '/AI-Tadpole-OS-Marketing/assets/real_mission/step3_execution_started.png',
            description: 'Authorizing sync triggers the RUN MISSION command. The MessagePack 10Hz telemetry pipeline opens, streaming real-time status into the Run Log and Event Log.',
            metrics: [
              { label: 'Telemetry Transport', value: 'MessagePack 10Hz' },
              { label: 'Assigned Agent', value: 'Agent of Nine (L2)' },
              { label: 'Run Log Status', value: 'Streaming Active' }
            ],
            logSnippet: '<span class="text-emerald-400">[RUN]</span> Mission cluster Strategic Command started. Agent of Nine dispatched.'
          },
          {
            shortTitle: 'OTel Waterfall',
            badge: 'Phase 4: Neural Trace Stream',
            title: 'OTel Neural Trace Waterfall Stream',
            image: '/AI-Tadpole-OS-Marketing/assets/real_mission/step4_execution_streaming.png',
            description: 'The OpenTelemetry (OTel) waterfall trace panel provides sub-millisecond visibility into subagent tool calls, memory indexing, and token scrubbing during high-speed execution.',
            metrics: [
              { label: 'Trace Granularity', value: 'Observe-Call-Audit' },
              { label: 'Token Scrubbing', value: '100% Real-Time' },
              { label: 'Subagent Concurrency', value: 'Parallel Futures' }
            ],
            logSnippet: '<span class="text-purple-400">[OTEL]</span> Trace ID 0x8f3a2b1c attached. Subagent execution 100% verified.'
          },
          {
            shortTitle: 'Zero-Trust Gate',
            badge: 'Phase 5: Execution Controls',
            title: 'Zero-Trust Execution Control (PAUSE)',
            image: '/AI-Tadpole-OS-Marketing/assets/real_mission/step5_execution_paused.png',
            description: 'The Overlord can pause, inspect, or abort missions at any millisecond. Clicking PAUSE freezes all Tokio task loops and logs: "⏸️ Mission cluster Strategic Command operations paused."',
            metrics: [
              { label: 'Gate Intercept Status', value: 'Operations Paused' },
              { label: 'Sapphire Shield', value: 'Armed & Freezing' },
              { label: 'State Isolation', value: '100% Air-Gapped' }
            ],
            logSnippet: '<span class="text-amber-400">[PAUSE]</span> ⏸️ Strategic Command operations paused by manual override.'
          },
          {
            shortTitle: 'Reconciliation',
            badge: 'Phase 6: Sovereign Audit',
            title: 'Mission Resume & Audit Reconciliation',
            image: '/AI-Tadpole-OS-Marketing/assets/real_mission/step6_execution_resumed.png',
            description: 'Resuming operations completes the security audit, generating a signed Merkle-proof certificate and updating the permanent audit ledger.',
            metrics: [
              { label: 'Execution State', value: 'Resumed & Completed' },
              { label: 'Audit Merkle Proof', value: '0x7f83a91b... Signed' },
              { label: 'Protocol Ledger', value: 'Reconciled' }
            ],
            logSnippet: '<span class="text-emerald-400">[RESUME]</span> ▶️ Strategic Command operations resumed. Audit certified.'
          }
        ],

        init() {
          this.startAutoPlayTimer();
          window.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowLeft') this.prevSlide();
            if (e.key === 'ArrowRight') this.nextSlide();
            if (e.key === 'Escape') this.lightboxOpen = false;
          });
        },

        setSlide(idx) {
          this.currentSlide = idx;
          this.resetAutoPlayProgress();
        },

        nextSlide() {
          this.currentSlide = (this.currentSlide + 1) % this.slides.length;
          this.resetAutoPlayProgress();
        },

        prevSlide() {
          this.currentSlide = (this.currentSlide - 1 + this.slides.length) % this.slides.length;
          this.resetAutoPlayProgress();
        },

        toggleAutoPlay() {
          this.autoPlay = !this.autoPlay;
          if (this.autoPlay) {
            this.startAutoPlayTimer();
          } else {
            this.clearAutoPlayTimers();
          }
        },

        startAutoPlayTimer() {
          this.clearAutoPlayTimers();
          if (!this.autoPlay) return;

          this.autoPlayProgress = 0;
          const intervalMs = 50;
          const totalMs = 4500;
          const increment = (intervalMs / totalMs) * 100;

          this.progressTimer = setInterval(() => {
            this.autoPlayProgress += increment;
            if (this.autoPlayProgress >= 100) {
              this.nextSlide();
            }
          }, intervalMs);
        },

        resetAutoPlayProgress() {
          this.autoPlayProgress = 0;
          if (this.autoPlay) {
            this.startAutoPlayTimer();
          }
        },

        clearAutoPlayTimers() {
          if (this.progressTimer) clearInterval(this.progressTimer);
        },

        openLightbox(imgUrl) {
          this.lightboxImg = imgUrl;
          this.lightboxOpen = true;
        }
      };
    }
  </script>

  <script is:inline src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
</BaseLayout>
