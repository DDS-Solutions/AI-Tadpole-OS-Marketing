---
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const screenshots = [
  {
    src: `${basePath}/assets/real_os_dashboard.png`,
    width: 1662,
    height: 905,
    title: "The whole operation. In view.",
    label: "Operations Command Center",
    desc: "Follow live swarm activity across 62 nodes, multi-slot model routing, and 10Hz telemetry from a single desktop workspace.",
    alt: "Tadpole OS operations dashboard displaying swarm telemetry, agent activity, and detachable workspace portals",
  },
  {
    src: `${basePath}/assets/real_os_nodes.png`,
    width: 1662,
    height: 905,
    title: "Codebase knowledge at scale.",
    label: "AST Neural Map & Symbols",
    desc: "Inspect 7,205 symbols and 43,517 dependency edges in real time with the BFS Dependency Pathfinder and Open Knowledge Format memory.",
    alt: "Tadpole OS neural map displaying codebase symbol graph, dependencies, and memory structures",
  },
  {
    src: `${basePath}/assets/real_os_oversight.png`,
    width: 1662,
    height: 905,
    title: "Zero-trust governance in action.",
    label: "Sapphire Shield Action Ledger",
    desc: "Review Human-In-The-Loop approval gates, inspect tool call parameters, and trace decisions through cryptographic Merkle audit records.",
    alt: "Tadpole OS Sapphire Shield oversight workspace with human approval gates and action ledger",
  },
  {
    src: `${basePath}/assets/real_os_missions.png`,
    width: 1662,
    height: 905,
    title: "Topological pipeline execution.",
    label: "Missions Flight Recorder",
    desc: "Topologically schedule multi-agent missions with Kahn's DAG sorting, live token telemetry, and forensic master-detail run histories.",
    alt: "Tadpole OS Missions Board showing active swarm clusters, Kanban pipeline, and execution telemetry",
  },
  {
    src: `${basePath}/assets/real_os_security.png`,
    width: 1662,
    height: 905,
    title: "Air-gapped boundary controls.",
    label: "Security & Privacy Shield",
    desc: "Enforce local model routing, fail-closed Plane 2 digital twin guards, and capability permissions without third-party data egress.",
    alt: "Tadpole OS Security Dashboard displaying Privacy Shield boundaries and compliance policies",
  },
  {
    src: `${basePath}/assets/real_os_hierarchy.png`,
    width: 1662,
    height: 905,
    title: "Structured swarm leadership.",
    label: "Topological Swarm Hierarchy",
    desc: "Coordinate strategic CEO/COO leadership, domain department clusters, and parallel subagent recruitment with observation sandboxing.",
    alt: "Tadpole OS Agent Hierarchy Org Chart showing CEO, Alpha Commander, and specialized department nodes",
  },
];
---

<section id="interface" class="interface-section" aria-labelledby="interface-title">
  <div class="section-shell">
    <div class="interface-intro">
      <div>
        <span class="eyebrow">Inside the workspace</span>
        <h2 id="interface-title" class="section-heading">Powerful systems.<br />A clear point of view.</h2>
      </div>
      <div class="intro-actions">
        <p class="section-copy">Authentic captures from the React + Tauri desktop runtime on port 5173. Inspect real-time agent orchestration, neural code graphs, and human-in-the-loop governance surfaces.</p>
        <a href={`${basePath}/gallery/`} class="gallery-explore-link">
          <span>Explore All 26 Screens in Full Gallery</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <div class="interface-gallery">
      {screenshots.map((shot, index) => (
        <figure class:list={["interface-figure", { "interface-featured": index === 0 }]}>
          <div class="screenshot-frame">
            <div class="screenshot-chrome" aria-hidden="true"><span class="window-dots"><i></i><i></i><i></i></span><span>AI-Tadpole-OS / {shot.label}</span><span class="chrome-mark">↗</span></div>
            <div class="screenshot-image">
              <img src={shot.src} alt={shot.alt} width={shot.width} height={shot.height} loading="lazy" decoding="async" />
              <button type="button" @click={`openLightbox('${shot.src}', '${shot.label}')`} aria-label={`Zoom Full Resolution: ${shot.label}`} class="preview-zoom">
                <svg width="14" height="14" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M7 3H3v4m10-4h4v4M3 13v4h4m10-4v4h-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
                <span>Zoom Full Resolution</span>
              </button>
            </div>
          </div>
          <figcaption>
            <div class="caption-title"><span class="caption-index">0{index + 1}</span><h3>{shot.title}</h3></div>
            <p>{shot.desc}</p>
          </figcaption>
        </figure>
      ))}
    </div>

    <div class="gallery-bottom-cta">
      <div class="cta-banner">
        <div>
          <h3>Want to inspect every single operational sector?</h3>
          <p>Browse all 26 screens, tab header views, and Axum Rust kernel probes with deep search, categorization, and full zoom inspection.</p>
        </div>
        <a href={`${basePath}/gallery/`} class="button-primary">
          Open Codebase Gallery (26 Screens)
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"></path></svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .interface-section { scroll-margin-top: 5rem; position: relative; padding: 5.5rem 0; border-top: 1px solid rgba(255,255,255,0.08); border-bottom: 1px solid rgba(255,255,255,0.08); background: radial-gradient(ellipse at 50% 30%, rgba(13,86,74,0.1), transparent 65%), #080d0e; }
  .interface-intro { display: grid; grid-template-columns: 1.12fr 0.88fr; gap: 4rem; align-items: end; margin-bottom: 3.5rem; }
  .intro-actions { display: flex; flex-direction: column; gap: 1rem; }
  .interface-intro .section-copy { max-width: 28rem; padding-bottom: 0.25rem; margin: 0; }
  .gallery-explore-link { display: inline-flex; align-items: center; gap: 0.5rem; color: #a7f3d0; font-size: 0.8rem; font-weight: 550; transition: color 150ms; }
  .gallery-explore-link:hover { color: #ffffff; }
  .interface-gallery { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 3rem 1.8rem; }
  .interface-figure { margin: 0; min-width: 0; }
  .interface-featured { grid-column: 1 / -1; }
  .screenshot-frame { overflow: hidden; border: 1px solid rgba(255,255,255,0.15); border-radius: 0.85rem; background: #080b0c; box-shadow: 0 22px 60px rgba(0,0,0,0.22); }
  .screenshot-chrome { height: 2.5rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0 0.85rem; border-bottom: 1px solid rgba(255,255,255,0.08); color: #8d9b97; font-size: 0.58rem; font-family: var(--font-mono); }
  .window-dots { display: flex; gap: 0.3rem; }
  .window-dots i { width: 5px; height: 5px; border-radius: 50%; background: #3c4a46; }
  .window-dots i:first-child { background: #6c857b; }
  .chrome-mark { color: #6ee7b7; font-size: 0.9rem; }
  .screenshot-image { position: relative; }
  .screenshot-image img { display: block; width: 100%; height: auto; }
  figcaption { margin-top: 1.3rem; }
  .caption-title { display: flex; align-items: center; gap: 0.85rem; }
  .caption-index { color: #6ee7b7; font-family: var(--font-mono); font-size: 0.65rem; }
  h3 { margin: 0; color: #edf4f1; font-size: 1.25rem; font-weight: 500; letter-spacing: -0.025em; line-height: 1.4; }
  figcaption p { margin: 0.55rem 0 0 1.8rem; max-width: 36rem; font-size: 0.85rem; line-height: 1.75; color: #99a7a1; }
  .interface-featured figcaption { display: flex; align-items: start; justify-content: space-between; gap: 2rem; }
  .interface-featured figcaption p { margin: 0; max-width: 29rem; }
  
  .gallery-bottom-cta { margin-top: 4.5rem; }
  .cta-banner { display: flex; align-items: center; justify-content: space-between; gap: 2rem; padding: 2rem 2.5rem; border-radius: 12px; border: 1px solid rgba(52, 211, 153, 0.25); background: linear-gradient(135deg, rgba(16, 185, 129, 0.08), rgba(6, 182, 212, 0.04)); box-shadow: 0 15px 50px rgba(0,0,0,0.3); }
  .cta-banner h3 { margin: 0 0 0.4rem; font-size: 1.15rem; color: #f4f4f5; font-weight: 600; }
  .cta-banner p { margin: 0; font-size: 0.84rem; color: #99a7a1; max-width: 38rem; line-height: 1.6; }
  .cta-banner .button-primary { flex-shrink: 0; display: inline-flex; align-items: center; gap: 0.6rem; }

  @media (max-width: 760px) {
    .interface-section { padding: 3.5rem 0; }
    .interface-intro { grid-template-columns: 1fr; gap: 1.3rem; margin-bottom: 2rem; }
    .interface-gallery { grid-template-columns: 1fr; gap: 2.25rem; }
    .interface-featured { grid-column: auto; }
    .interface-featured figcaption { display: block; }
    .interface-featured figcaption p { margin: 0.55rem 0 0 1.8rem; }
    .screenshot-chrome { font-size: 0.5rem; gap: 0.5rem; }
    h3 { font-size: 1.15rem; }
    .cta-banner { flex-direction: column; align-items: flex-start; padding: 1.5rem; gap: 1.25rem; }
    .cta-banner .button-primary { width: 100%; justify-content: center; }
  }
</style>
