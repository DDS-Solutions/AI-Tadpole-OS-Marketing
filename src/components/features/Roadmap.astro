---
const priorities = [
  {
    number: "01",
    title: "Plane 1: Sovereign Engine (GA)",
    detail:
      "Production-ready codebase lifecycle engine with Rust Axum runtime, Tree-sitter AST symbol graphs, Active Documentation Guard (ADG v2), and Agent 99 self-annealing.",
  },
  {
    number: "02",
    title: "Plane 2: SMB Digital Twin (Preview)",
    detail:
      "Developer sandbox and scenario previews for small-to-medium business workflows (Shopify, QuickBooks, Gmail) with fail-closed tenant workspace isolation.",
  },
  {
    number: "03",
    title: "A2A Economic Zone & 2PC Ledger",
    detail:
      "Service-to-service payment protocol featuring two-phase commit locks, x402 challenge handshakes, daily budget caps, and asynchronous model reasoning mailboxes.",
  },
  {
    number: "04",
    title: "Sovereign Compliance & P2P Mesh",
    detail:
      "Deterministic regulatory invariant testing (ECC-ID, GxP, ISO 9001, ISO 42001, NIST AI-RMF) paired with decentralized peer discovery and distributed swarm coordination.",
  },
];
---

<section id="roadmap" class="roadmap-section" aria-labelledby="roadmap-title">
  <div class="section-shell">
    <div class="roadmap-intro">
      <div>
        <span class="eyebrow">Engineering direction</span>
        <h2 id="roadmap-title" class="section-heading">
          A dual-plane roadmap.
          <br />
          Built for sovereignty.
        </h2>
      </div>
      <p class="section-copy">
        Follow the engineering trajectory in the open. Plane 1 delivers active
        codebase autonomy today; Plane 2 establishes the isolated digital twin
        infrastructure for tomorrow's enterprise workflows.
      </p>
    </div>
    <ol class="roadmap-grid">
      {priorities.map((item) => (
        <li>
          <span class="roadmap-number">
            {item.number}
            <span aria-hidden="true"></span>
          </span>
          <h3>{item.title}</h3>
          <p>{item.detail}</p>
        </li>
      ))}
    </ol>
    <a
      href="https://github.com/DDS-Solutions/AI-TadPole-OS/releases"
      class="roadmap-link"
    >
      Explore releases on GitHub <span aria-hidden="true">↗</span>
    </a>
  </div>
</section>

<style>
  .roadmap-section {
    padding: clamp(3rem, 5vw, 5rem) 0;
    border-block: 1px solid var(--line);
    background: #0b100d80;
  }
  .roadmap-intro {
    display: grid;
    grid-template-columns: 1.12fr 0.88fr;
    align-items: end;
    gap: 4rem;
    margin-bottom: 3.5rem;
  }
  .roadmap-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem;
  }
  .roadmap-number {
    display: flex;
    align-items: center;
    gap: 1rem;
    font: 0.65rem var(--font-mono);
    color: #6ee7b7;
  }
  .roadmap-number > span {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, #6ee7b730, #ffffff08);
  }
  h3 {
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: -0.03em;
    color: #e4eee8;
    margin-top: 1.5rem;
  }
  li > p {
    font-size: 0.8rem;
    line-height: 1.85;
    color: #9ca9a1;
    margin-top: 0.85rem;
  }
  .roadmap-link {
    display: inline-flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 44px;
    margin-top: 2rem;
    color: #a7f3d0;
    font-size: 0.75rem;
  }
  .roadmap-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  @media (max-width: 900px) {
    .roadmap-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem;
    }
  }
  @media (max-width: 700px) {
    .roadmap-intro {
      grid-template-columns: 1fr;
      gap: 1.3rem;
      margin-bottom: 2.5rem;
    }
  }
  @media (max-width: 479px) {
    .roadmap-grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
    h3 {
      margin-top: 1rem;
    }
  }
</style>
