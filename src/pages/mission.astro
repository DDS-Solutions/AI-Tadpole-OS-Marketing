        selectDirective(key) {
          if (this.state === 'RUNNING' || this.state === 'HITL_WAIT') return;
          this.selectedScenario = key;
          const s = this.scenarios[key];
          this.activeScenarioTitle = s.title;
          this.activeDirectiveFile = s.directive;
          this.finalReport.time = s.time;
          this.finalReport.savings = s.savings;
          this.resetMission();
        },

        resetMission() {
          this.state = 'IDLE';
          this.progress = 0;
          this.logs = [];
          this.nodeStatus = { overlord: 'IDLE', agent99: 'IDLE', tadpole: 'IDLE', sapphire: 'READY' };
          this.metrics = { threads: '0/16', busRate: '0 Hz', scrubbed: '0' };
        },

        toggleAudio() {
          this.soundEnabled = !this.soundEnabled;
          if (this.soundEnabled) this.playClickSound(800, 0.05);
        },

        playClickSound(freq = 1200, duration = 0.03) {
          if (!this.soundEnabled) return;
          try {
            if (!this.audioCtx) {
              this.audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
            if (this.audioCtx.state === 'suspended') {
              this.audioCtx.resume();
            }
            const now = this.audioCtx.currentTime;
            const osc = this.audioCtx.createOscillator();
            const gain = this.audioCtx.createGain();
            osc.type = 'sine';
            osc.frequency.setValueAtTime(freq + Math.random() * 100, now);
            gain.gain.setValueAtTime(0.03, now);
            gain.gain.exponentialRampToValueAtTime(0.001, now + duration);
            osc.connect(gain);
            gain.connect(this.audioCtx.destination);
            osc.start(now);
            osc.stop(now + duration);
          } catch(e) {}
        },

        async startMission() {
          this.resetMission();
          this.state = 'RUNNING';
          this.playClickSound(600, 0.08);

          const scenario = this.scenarios[this.selectedScenario];
          const steps = scenario.steps;
          const totalSteps = steps.length;

          let stepIdx = 0;
          
          const processNextStep = () => {
            if (stepIdx >= steps.length) {
              this.state = 'COMPLETE';
              this.progress = 100;
              this.playClickSound(1400, 0.15);
              return;
            }

            const step = steps[stepIdx];

            if (step.hitl) {
              // Pause at HITL Gate
              this.state = 'HITL_WAIT';
              this.logs.push({
                timestamp: new Date().toLocaleTimeString('en-US', { hour12: false }),
                tag: step.tag,
                colorClass: step.color,
                message: step.msg
              });
              if (step.node) this.nodeStatus = { ...this.nodeStatus, ...step.node };
              this.progress = Math.round(((stepIdx + 1) / totalSteps) * 100);
              this.playClickSound(400, 0.12);
              this.scrollToBottom();
              stepIdx++;
              return;
            }

            // Normal Log Entry
            this.logs.push({
              timestamp: new Date().toLocaleTimeString('en-US', { hour12: false }),
              tag: step.tag,
              colorClass: step.color,
              message: step.msg
            });

            if (step.node) this.nodeStatus = { ...this.nodeStatus, ...step.node };
            if (step.metrics) this.metrics = { ...this.metrics, ...step.metrics };

            this.progress = Math.round(((stepIdx + 1) / totalSteps) * 100);
            this.playClickSound(1000 + Math.random() * 300, 0.03);
            this.scrollToBottom();

            stepIdx++;
            const nextDelay = (step.delay || 800) / this.speed;
            setTimeout(processNextStep, nextDelay);
          };

          processNextStep();
        },

        approveHITL() {
          this.playClickSound(1500, 0.1);
          this.state = 'RUNNING';
          const scenario = this.scenarios[this.selectedScenario];
          const steps = scenario.steps;
          
          // Resume execution after HITL approval
          let stepIdx = 5; // Resume from post-HITL steps
          
          const processNextStep = () => {
            if (stepIdx >= steps.length) {
              this.state = 'COMPLETE';
              this.progress = 100;
              this.playClickSound(1600, 0.2);
              return;
            }

            const step = steps[stepIdx];
            this.logs.push({
              timestamp: new Date().toLocaleTimeString('en-US', { hour12: false }),
              tag: step.tag,
              colorClass: step.color,
              message: step.msg
            });

            if (step.node) this.nodeStatus = { ...this.nodeStatus, ...step.node };
            if (step.metrics) this.metrics = { ...this.metrics, ...step.metrics };

            this.progress = Math.round(((stepIdx + 1) / steps.length) * 100);
            this.playClickSound(1100, 0.04);
            this.scrollToBottom();

            stepIdx++;
            const nextDelay = (step.delay || 800) / this.speed;
            setTimeout(processNextStep, nextDelay);
          };

          processNextStep();
        },

        rejectHITL() {
          this.playClickSound(300, 0.15);
          this.logs.push({
            timestamp: new Date().toLocaleTimeString('en-US', { hour12: false }),
            tag: '[SAPPHIRE]',
            colorClass: 'text-red-400 font-bold',
            message: '❌ Overlord REJECTED shell execution. Mission aborted safely into air-gapped sandbox.'
          });
          this.state = 'IDLE';
          this.nodeStatus.sapphire = 'AIR-GAPPED';
          this.nodeStatus.overlord = 'REJECTED';
        },

        scrollToBottom() {
          setTimeout(() => {
            const el = document.getElementById('terminal-scroll-container');
            if (el) el.scrollTop = el.scrollHeight;
          }, 50);
        }
      };
    }
